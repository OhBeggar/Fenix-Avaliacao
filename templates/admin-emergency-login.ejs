<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Entrar com código | Fênix</title>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/adm.css">
    <link rel="icon" href="/images/icons8-fenix-cute-color-70.png" type="image/png">
</head>
<body class="admin-body">
    <main class="admin-login-shell">
        <section class="login-card">
            <img src="/images/fenix.svg" alt="Fênix" width="64" height="64">
            <p class="eyebrow">Acesso de emergência</p>
            <h1>Entrar com código</h1>
            <p class="panel-copy">O código recebido por e-mail vale por 30 minutos e só pode ser usado uma vez.</p>
            <% if (message) { %><p class="admin-recovery-message" role="alert"><%= message %></p><% } %>
            <form method="POST" action="/admin/emergency-login" class="stack-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <label>E-mail administrativo
                    <input type="email" name="email" required maxlength="254" autocomplete="email">
                </label>
                <label>Código de 5 dígitos
                    <input type="text" name="code" required inputmode="numeric" maxlength="5" pattern="[0-9]{5}" autocomplete="one-time-code">
                </label>
                <button type="submit">Entrar</button>
            </form>
            <a href="/admin/login" class="back-link">Voltar ao login</a>
        </section>
    </main>
</body>
</html>
