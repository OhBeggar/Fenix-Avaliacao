<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof historicalEvent !== 'undefined' ? 'Histórico Oficial' : 'Resultados Finais' %> | Fênix Dança</title>
    <script>
    (function () {
      try {
        var t = localStorage.getItem('fenix-theme');
        if (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          t = 'dark';
        }
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
    </script>
    <link rel="stylesheet" href="/theme.css">
    <link rel="icon" href="/images/icons8-fenix-cute-color-70.png" type="image/png">
    <link rel="stylesheet" href="/resultados.css?v=2">
</head>
<body>
    <%
        const isHistorical = typeof historicalEvent !== 'undefined';
        const liveStatus = typeof liveEvaluatorStatus !== 'undefined' && liveEvaluatorStatus
            ? liveEvaluatorStatus
            : { activeCount: numEvaluators, activeNames: activeEvaluators || [] };
        const isSessionClosed = !isHistorical && typeof sessionClosed !== 'undefined' && sessionClosed;
        const summaryLabel = isHistorical
            ? 'Avaliadores registrados'
            : (isSessionClosed ? 'Sessão encerrada' : 'Avaliadores ativos');
        const summaryCount = isHistorical ? numEvaluators : liveStatus.activeCount;
        const summaryNames = isHistorical ? activeEvaluators : liveStatus.activeNames;
    %>
    <main class="results-shell">
        <header class="results-header">
            <div class="results-header-top">
                <img src="/images/icons8-fenix-cute-color-96.png" alt="Fênix Dança">
                <div class="header-text">
                    <span class="eyebrow"><%= isHistorical ? 'HISTÓRICO OFICIAL' : 'CONSOLIDAÇÃO OFICIAL' %></span>
                    <h1><%= dynamicTitle %></h1>
                </div>
            </div>
            <p class="results-subtitle">
                Resultados finais com médias por critério, nota final e maioria simples.
                <button type="button" class="help-tip" id="rulesHelpBtn" aria-label="Ver regras de aprovação" title="Regras de aprovação">?</button>
            </p>
            <p class="active-summary">
                <%= summaryLabel %>: <strong><%= summaryCount %></strong>
                <% if (summaryNames && summaryNames.length > 0) { %>
                    — <%= summaryNames.join(', ') %>
                <% } %>
            </p>
        </header>

        <div class="results-actions">
            <a href="<%= isHistorical ? '/results/history' : '/admin' %>" class="ghost-link nav-action back">
                Voltar
            </a>

            <label class="results-search" aria-label="Buscar candidato">
                <span class="search-icon" aria-hidden="true">⌕</span>
                <input
                    type="search"
                    id="candidateSearch"
                    placeholder="Buscar candidato..."
                    autocomplete="off"
                >
            </label>
            <% if (!isHistorical && typeof activeTurmas !== 'undefined' && activeTurmas.length > 1) { %>
                <form method="GET" action="/results" class="turma-filter-form">
                    <select name="turmaId" onchange="this.form.submit()">
                        <% activeTurmas.forEach(t => { %>
                            <option value="<%= t.id %>" <%= t.id == selectedTurmaId ? 'selected' : '' %>>
                                <%= t.name %>
                            </option>
                        <% }) %>
                    </select>
                </form>
            <% } else if (isHistorical) { %>
                <% 
                    const evaluatorsMap = {};
                    if (results && results.length > 0) {
                        results.forEach(r => {
                            if (r.individual_evaluations) {
                                Object.entries(r.individual_evaluations).forEach(([id, evalData]) => {
                                    if (!evaluatorsMap[id] && evalData && evalData.name) {
                                        evaluatorsMap[id] = evalData.name;
                                    }
                                });
                            }
                        });
                    }
                    const evaluatorIds = Object.keys(evaluatorsMap);
                %>
                <% if (evaluatorIds.length > 0) { %>
                    <div class="turma-filter-form">
                        <select id="evaluatorFilter" onchange="updateTable(this.value)">
                            <option value="global">Ver: Consolidação Oficial</option>
                            <% evaluatorIds.forEach(evaluatorId => { %>
                                <option value="<%= evaluatorId %>">Ver notas de: <%= evaluatorsMap[evaluatorId] %></option>
                            <% }) %>
                        </select>
                    </div>
                <% } %>
            <% } %>

            <% if (isHistorical && typeof historicalEvent !== 'undefined' && historicalEvent) { %>
                <% if (typeof canExportPdf !== 'undefined' && canExportPdf) { %>
                    <a class="btn-export" href="/export_pdf/history/<%= historicalEvent.id %>">
                        PDF
                    </a>
                <% } %>

                <a class="btn-export btn-export-excel" href="/export_excel/history/<%= historicalEvent.id %>">
                    Excel
                </a>
            <% } %>
        </div>

        <% 
            const totalCands = results ? results.length : 0;
            const totalAprov = results ? results.filter(r => r.status === 'Aprovado').length : 0;
            const totalReprov = totalCands - totalAprov;
        %>
        <div class="results-summary">
            <div class="summary-item">
                <strong><%= totalCands %></strong>
                <span>candidatos</span>
            </div>
            <div class="summary-item aprov">
                <strong><%= totalAprov %></strong>
                <span>aprovados</span>
            </div>
            <div class="summary-item reprov">
                <strong><%= totalReprov %></strong>
                <span>reprovados</span>
            </div>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Nº</th>
                        <th>Candidato</th>
                        <th>Presença</th>
                        <th>Pres. Auxílios</th>
                        <th>Comprometimento</th>
                        <th>Desloc./Floreio</th>
                        <th>Abraço</th>
                        <th>Equilíbrio</th>
                        <th>Passos</th>
                        <th>Ritmo</th>
                        <th>C. Ritmo</th>
                        <th>Condução</th>
                        <th>Musicalidade</th>
                        <th>Nota Final</th>
                        <th class="col-aprov">Aprov.</th>
                        <th class="col-reprov">Reprov.</th>
                        <th>Status</th>
                        <th>Patente</th>
                    </tr>
                </thead>
                <tbody id="resultsTableBody">
                    <% if (results && results.length > 0) { %>
                        <% results.forEach((result, i) => { %>
                            <tr data-index="<%= i %>">
                                <td><%= i + 1 %></td>
                                <td class="candidate-name"><%= result.name %></td>
                                <td><%= result.presence %></td>
                                <td data-crit="presenca_auxilios"><%= result.averages.presenca_auxilios || '-' %></td>
                                <td data-crit="comprometimento_eventos"><%= result.averages.comprometimento_eventos || '-' %></td>
                                <td data-crit="peso2"><%= result.averages.deslocamento_cavalheiro || result.averages.floreio_dama || '-' %></td>
                                <td data-crit="abraco_postura"><%= result.averages.abraco_postura || '-' %></td>
                                <td data-crit="equilibrio"><%= result.averages.equilibrio || '-' %></td>
                                <td data-crit="passos"><%= result.averages.passos || '-' %></td>
                                <td data-crit="ritmo"><%= result.averages.ritmo || '-' %></td>
                                <td data-crit="corpo_ritmo"><%= result.averages.corpo_ritmo || '-' %></td>
                                <td data-crit="conducao"><%= result.averages.conducao || '-' %></td>
                                <td data-crit="musicalidade"><%= result.averages.musicalidade || '-' %></td>
                                <td class="final-note <%= result.final_note >= 7 ? 'nota-alta' : 'nota-baixa' %>">
                                    <%= result.final_note %>
                                </td>
                                <td class="col-aprov"><%= result.approved %></td>
                                <td class="col-reprov"><%= result.reproved %></td>
                                <td class="status-cell"><strong><%= result.status %></strong></td>
                                <td><%= result.final_status %></td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="18" style="text-align: center; padding: 40px; color: var(--muted);">
                                Nenhum resultado encontrado.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>

        <p class="results-rule">
            <strong>Aprovado</strong> = nota média >= 7,0 e maioria simples dos avaliadores 
            (mais de <%= Math.floor(numEvaluators / 2) %> aprovações).
        </p>

        <div class="rules-popover" id="rulesPopover" hidden>
            <div class="rules-popover-header">
                <strong>Regras de aprovação</strong>
                <button type="button" class="rules-popover-close" id="rulesHelpClose" aria-label="Fechar">×</button>
            </div>
            <ul>
                <li><strong>Presença mínima:</strong> abaixo de 80% → reprovação automática (independente das notas).</li>
                <li><strong>Nota final:</strong> média ponderada (Peso 1 = 10%, Peso 2 = 30%, Peso 3 = 60%).</li>
                <li><strong>Corte:</strong> nota final ≥ 7,0.</li>
                <li><strong>Maioria simples:</strong> mais da metade dos avaliadores precisa aprovar. Empate reprova.</li>
                <li><strong>Aprovado</strong> só se cumprir nota ≥ 7,0 <em>e</em> maioria.</li>
                <li><strong>Patente:</strong> aprovado sobe de patente no fechamento (ex.: Bolsista → Auxiliar).</li>
            </ul>
        </div>
    </main>

    <script>
        const rawResults = <%- JSON.stringify(results || []) %>;

        function updateTable(evaluatorId) {
            const isGlobal = evaluatorId === 'global';
            
            // Mostrar ou ocultar colunas de aprovação/reprovação
            const colsToHide = document.querySelectorAll('.col-aprov, .col-reprov');
            colsToHide.forEach(el => {
                el.style.display = isGlobal ? '' : 'none';
            });

            // Atualizar os valores da tabela
            const rows = document.querySelectorAll('#resultsTableBody tr[data-index]');
            rows.forEach((row, idx) => {
                const result = rawResults[idx];
                if (!result) return;

                const evalData = result.individual_evaluations ? result.individual_evaluations[evaluatorId] : null;
                const isAutoReproved = result.status === 'Presença insuficiente';
                const data = isGlobal ? (result.averages || {}) : (evalData?.scores || {});
                
                const finalNote = isGlobal ? result.final_note : (evalData ? evalData.finalNote : (isAutoReproved ? 0 : '-'));
                const statusStr = isGlobal ? result.status : (isAutoReproved ? result.status : (evalData ? (evalData.isApproved ? 'Aprovado' : 'Reprovado') : 'Sem notas'));
                const displayStatus = statusStr;

                const getVal = (key) => {
                    // Para o peso2, verificamos deslocamento ou floreio
                    if (key === 'peso2') {
                        return data.deslocamento_cavalheiro || data.floreio_dama || '-';
                    }
                    return data[key] || '-';
                };

                row.querySelector('[data-crit="presenca_auxilios"]').textContent = getVal('presenca_auxilios');
                row.querySelector('[data-crit="comprometimento_eventos"]').textContent = getVal('comprometimento_eventos');
                row.querySelector('[data-crit="peso2"]').textContent = getVal('peso2');
                row.querySelector('[data-crit="abraco_postura"]').textContent = getVal('abraco_postura');
                row.querySelector('[data-crit="equilibrio"]').textContent = getVal('equilibrio');
                row.querySelector('[data-crit="passos"]').textContent = getVal('passos');
                row.querySelector('[data-crit="ritmo"]').textContent = getVal('ritmo');
                row.querySelector('[data-crit="corpo_ritmo"]').textContent = getVal('corpo_ritmo');
                row.querySelector('[data-crit="conducao"]').textContent = getVal('conducao');
                row.querySelector('[data-crit="musicalidade"]').textContent = getVal('musicalidade');

                const finalNoteCell = row.querySelector('.final-note');
                finalNoteCell.textContent = finalNote;
                finalNoteCell.className = 'final-note ' + (typeof finalNote === 'number' && finalNote >= 7 ? 'nota-alta' : 'nota-baixa');

                row.querySelector('.status-cell strong').textContent = displayStatus;
            });
        }

        // Auto-refresh a cada 15 segundos (apenas para resultados em tempo real, não para histórico)
        <% if (!isHistorical) { %>
        setInterval(() => {
            if (!document.hidden) {
                location.reload();
            }
        }, 15000);
        <% } %>
    </script>
    <script>
    (function () {
        const input = document.getElementById('candidateSearch');
        const tbody = document.getElementById('resultsTableBody');
        if (!input || !tbody) return;

        function normalize(text) {
            return String(text || '')
                .normalize('NFD')
                .replace(/[\u0300-\u036f]/g, '')
                .toLowerCase()
                .trim();
        }

        function filterRows() {
            const q = normalize(input.value);
            const rows = tbody.querySelectorAll('tr[data-index]');

            rows.forEach(row => {
                const nameCell = row.querySelector('.candidate-name');
                const name = normalize(nameCell ? nameCell.textContent : '');
                const match = !q || name.includes(q);
                row.classList.toggle('search-hidden', !match);
            });
        }

        input.addEventListener('input', filterRows);
        input.addEventListener('search', filterRows); // limpar no "x" do input type=search
    })();
    </script>
    <script>
    (function () {
        const btn = document.getElementById('rulesHelpBtn');
        const pop = document.getElementById('rulesPopover');
        const closeBtn = document.getElementById('rulesHelpClose');
        if (!btn || !pop) return;

        function placePopover() {
            const rect = btn.getBoundingClientRect();
            const gap = 8;
            let top = rect.bottom + gap;
            let left = rect.left + rect.width / 2 - pop.offsetWidth / 2;

            // Mantém dentro da viewport
            left = Math.max(12, Math.min(left, window.innerWidth - pop.offsetWidth - 12));
            if (top + pop.offsetHeight > window.innerHeight - 12) {
                top = rect.top - pop.offsetHeight - gap;
            }
            pop.style.top = top + 'px';
            pop.style.left = left + 'px';
        }

        function open() {
            pop.hidden = false;
            btn.setAttribute('aria-expanded', 'true');
            placePopover();
        }

        function close() {
            pop.hidden = true;
            btn.setAttribute('aria-expanded', 'false');
        }

        function toggle() {
            if (pop.hidden) open();
            else close();
        }

        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            toggle();
        });

        if (closeBtn) closeBtn.addEventListener('click', close);

        document.addEventListener('click', function (e) {
            if (!pop.hidden && !pop.contains(e.target) && e.target !== btn) {
                close();
            }
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') close();
        });

        window.addEventListener('resize', function () {
            if (!pop.hidden) placePopover();
        });
    })();
    </script>
    <script src="/theme.js"></script>
    <script src="/back.js"></script>
</body>
</html>
