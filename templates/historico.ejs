<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Histórico Oficial | Fênix Dança</title>
    <script>
    (function () {
      try {
        var t = localStorage.getItem('fenix-theme');
        if (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          t = 'dark';
        }
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
    </script>
    <link rel="icon" href="/images/icons8-fenix-cute-color-70.png" type="image/png">
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/adm.css">
    <style>
         .placeholder-text {
            color: var(--muted);
            font-size: 1.0rem;
            line-height: 1.6;
            text-align: center;
            margin: 20px auto 40px auto;
            max-width: 600px;
        }
        .historico-shell {
            width: min(1240px, calc(100% - 24px));
            margin: 20px auto 40px;
        }
        .historico-header {
            margin-bottom: 18px;
        }
        .historico-header-top {
            display: flex;
            gap: 16px;
            align-items: center;
            justify-content: center;
            margin-bottom: 12px;
        }
        .historico-header-top img {
            height: 50px;
            width: auto;
        }
        .historico-header-top .header-text {
            text-align: center;
        }
        .historico-actions {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
            align-items: center;
            flex-wrap: wrap;
        }
        .historico-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 16px;
        }
        .historico-card {
            position: relative;
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 20px;
            transition: all 0.2s ease;
        }
        .historico-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        }
        .historico-card h3 {
            margin: 0 0 8px;
            color: var(--ink);
            font-size: 1.1rem;
        }
        .historico-card p {
            margin: 4px 0;
            color: var(--muted);
            font-size: 0.9rem;
        }
        .historico-card .actions {
            display: flex;
            gap: 8px;
            margin-top: 16px;
        }
        .historico-card .actions button,
        .historico-card .actions a {
            flex: 1;
            text-align: center;
            padding: 8px 12px;
            border-radius: 8px;
            font-weight: 600;
            text-decoration: none;
            font-size: 0.9rem;
        }
        .btn-view {
            background: var(--primary);
            color: white;
            border: none;
            cursor: pointer;
        }
        .btn-pdf {
            background: #166534;
            color: white;
            border: none;
            cursor: pointer;
        }
        .delete-history-form {
            position: absolute;
            top: 14px;
            right: 14px;
            margin: 0;
        }
        .delete-history-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            padding: 0;
            color: var(--danger, #8B0D16);
            background: var(--panel, #fff);
            border: 1.5px solid var(--danger, #8B0D16);
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 800;
            line-height: 1;
            cursor: pointer;
            transition: background 0.15s ease, color 0.15s ease;
        }
        .delete-history-btn:hover {
            color: #fff;
            background: var(--danger, #8B0D16);
        }
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--muted);
            background: var(--panel);
            border-radius: 16px;
            border: 2px dashed var(--line);
        }
    </style>
</head>
<body class="admin-body">
    <div class="historico-shell">
        <header class="historico-header">
            <div class="historico-header-top">
                <img src="/images/icons8-fenix-cute-color-96.png" alt="Fênix Dança">
                <div class="header-text">
                    <span class="eyebrow">Painel Administrativo</span>
                    <h1>Histórico Oficial de Avaliações</h1>
                </div>
            </div>
            <p class="placeholder-text">Avaliações fechadas ficam congeladas aqui, mesmo que notas, presenças ou professores mudem depois. Gere PDFs de qualquer audição passada.</p>
        </header>

        <div class="historico-actions">
            <a href="/admin" class="ghost-link nav-action back">
                Voltar
            </a>
        </div>

        <% if (typeof message !== 'undefined' && message) { %>
            <div id="toast-data"
                 data-message="<%= message.text %>"
                 data-type="<%= message.type === 'success' ? 'success' : 'error' %>"
                 style="display:none"></div>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const dataEl = document.getElementById('toast-data');
                    if (window.showToast && dataEl) {
                        showToast(dataEl.dataset.message, dataEl.dataset.type);
                    }
                });
            </script>
        <% } %>

        <% if (history && history.length > 0) { %>
            <div class="historico-grid">
                <% history.forEach(event => { %>
                    <div class="historico-card">
                        <button type="button"
                                class="delete-history-form delete-history-btn btn-delete-history"
                                data-event-id="<%= event.id %>"
                                data-event-title="<%= event.title %>"
                                title="Excluir este histórico"
                                aria-label="Excluir histórico">×</button>
                        <h3><%= event.title %></h3>
                        <p><strong>Turma:</strong> <%= event.turma_name || 'N/A' %></p>
                        <p><strong>Fechada em:</strong> <%= new Date(event.closed_at).toLocaleDateString('pt-BR') %></p>
                        <p><strong>Avaliadores:</strong> <%= event.num_evaluators %></p>
                        <div class="actions">
                            <a href="/results/history/<%= event.id %>" class="btn-view">
                                Ver Detalhes
                            </a>
                            <a href="/export_pdf/history/<%= event.id %>" class="btn-pdf">
                                📄 PDF
                            </a>
                            <a href="/export_excel/history/<%= event.id %>" class="btn-pdf btn-excel">
                                📊 Excel
                            </a>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="empty-state">
                <p style="font-size: 1.1rem; margin: 0;">Nenhuma avaliação fechada ainda.</p>
                <p style="margin: 8px 0 0;">Feche uma sessão de avaliação para vê-la aqui.</p>
            </div>
        <% } %>
    </div>

    <dialog id="deleteHistoryModal" class="admin-modal">
        <form method="POST" id="deleteHistoryForm">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="eventId" id="deleteHistoryEventId">

            <div class="modal-header danger">
                <h3>Excluir histórico</h3>
                <button type="button" class="modal-close" data-close-modal aria-label="Fechar">×</button>
            </div>

            <div class="modal-body">
                <p class="modal-lead">
                    Esta ação é <strong>permanente</strong>. O registro oficial será removido e não poderá ser recuperado pelo sistema.
                </p>

                <div class="modal-turmas">
                    <span class="modal-label">Registro a excluir</span>
                    <p id="deleteHistoryTitle" style="margin:0; font-weight:700;"></p>
                </div>

                <p class="modal-warning">
                    Só confirme se tiver certeza. PDFs/Excel já baixados não são afetados.
                </p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancel" data-close-modal>Cancelar</button>
                <button type="submit" class="btn-danger-confirm">Excluir definitivamente</button>
            </div>
        </form>
    </dialog>

    <script src="/toast.js"></script>
    <script src="/theme.js"></script>
    <script src="/back.js"></script>
    <script>
        (() => {
            const modal = document.getElementById('deleteHistoryModal');
            const form = document.getElementById('deleteHistoryForm');
            const titleEl = document.getElementById('deleteHistoryTitle');
            const eventIdEl = document.getElementById('deleteHistoryEventId');
            if (!modal || !form || !titleEl || !eventIdEl) return;

            const closeModal = () => {
                if (typeof modal.close === 'function') modal.close();
                else modal.removeAttribute('open');
            };

            document.querySelectorAll('.btn-delete-history').forEach((button) => {
                button.addEventListener('click', () => {
                    const id = button.dataset.eventId;
                    titleEl.textContent = button.dataset.eventTitle || `Registro #${id}`;
                    eventIdEl.value = id;
                    form.action = '/admin/history/delete';
                    if (typeof modal.showModal === 'function') modal.showModal();
                    else modal.setAttribute('open', '');
                });
            });

            modal.querySelectorAll('[data-close-modal]').forEach((button) => {
                button.addEventListener('click', closeModal);
            });

            modal.addEventListener('click', (event) => {
                if (event.target === modal) closeModal();
            });
        })();
    </script>
</body>
</html>
