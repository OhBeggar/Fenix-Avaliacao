<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Administrativo</title>
    <link rel="stylesheet" href="/adm.css">
    <link rel="stylesheet" href="/theme.css">
    <link rel="icon" href="/images/icons8-fenix-cute-color-70.png" type="image/png">
</head>
<body class="admin-body">
    <main class="admin-login-shell">
        <div class="login-card">
            <div style="margin-bottom: 20px;">
                <img src="/images/icons8-fenix-cute-color-96.png" alt="Icon" style="height: 64px; width: auto;">
            </div>
            <div class="eyebrow">Painel administrativo</div>
            <h1>Acesso restrito</h1>
            <p class="panel-copy">
                Use a senha cadastrada em <code>ADMIN_PASSWORD.</code>
            </p>

        <% if (typeof message !== 'undefined' && message) { %>
            <div id="toast-data" data-message="<%= message %>" data-type="error" style="display:none"></div>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const dataEl = document.getElementById('toast-data');
                    if (window.showToast && dataEl) {
                        showToast(dataEl.dataset.message, dataEl.dataset.type);
                    }
                });
            </script>
        <% } %>

        <form method="POST" action="/admin/login" class="stack-form">
            <label>
                <input placeholder="Senha" type="password" name="password" required autofocus>
            </label>
            <button type="submit">Entrar</button>
        </form>

        <a href="/" class="back-link nav-action back">Voltar para a página inicial</a>
    </div>

    <script src="/transitions.js"></script>
    <script src="/toast.js"></script>
    <script src="/back.js"></script>
</body>
</html>
