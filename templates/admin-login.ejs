<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Administrativo</title>
    <script>
    (function () {
      try {
        var t = localStorage.getItem('fenix-theme');
        if (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          t = 'dark';
        }
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
    </script>
    <link rel="stylesheet" href="/adm.css?v=12">
    <link rel="stylesheet" href="/theme.css">
    <link rel="icon" href="/images/fenix-new.png" type="image/png">
</head>
<body class="admin-body">
    <div class="theme-switch-floating">
        <label class="theme-switch" title="Alternar tema">
          <input class="theme-switch-input" type="checkbox" role="switch" aria-label="Alternar tema claro e escuro">
          <div class="slider round">
            <div class="sun-moon">
              <svg class="moon-dot moon-dot-1" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="moon-dot moon-dot-2" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="moon-dot moon-dot-3" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="light-ray light-ray-1" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="light-ray light-ray-2" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="light-ray light-ray-3" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="cloud-dark cloud-1" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="cloud-dark cloud-2" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="cloud-dark cloud-3" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="cloud-light cloud-4" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="cloud-light cloud-5" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="cloud-light cloud-6" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
            </div>
            <div class="stars">
              <svg class="star star-1" viewBox="0 0 20 20">
                <path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"></path>
              </svg>
              <svg class="star star-2" viewBox="0 0 20 20">
                <path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"></path>
              </svg>
              <svg class="star star-3" viewBox="0 0 20 20">
                <path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"></path>
              </svg>
              <svg class="star star-4" viewBox="0 0 20 20">
                <path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"></path>
              </svg>
            </div>
          </div>
        </label>
    </div>
    <main class="admin-login-shell">
        <div class="login-card">
            <div style="margin-bottom: 20px;">
                <img src="/images/fenix.svg" alt="Icon" style="height: 64px; width: auto;">
            </div>
            <div class="eyebrow">Painel administrativo</div>
            <h1>Acesso restrito</h1>
            <p class="panel-copy">
                <code>Use a senha cadastrada.</code>
            </p>

        <% if (typeof message !== 'undefined' && message) { %>
            <div id="toast-data" data-message="<%= message %>" data-type="error" style="display:none"></div>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const dataEl = document.getElementById('toast-data');
                    if (window.showToast && dataEl) {
                        showToast(dataEl.dataset.message, dataEl.dataset.type);
                    }
                });
            </script>
        <% } %>

        <% if (typeof webauthn !== 'undefined' && webauthn.enabled) { %>
        <div id="adminBioPanel" class="stack-form" style="display:none">
            <button type="button" id="adminBioBtn">Entrar com biometria</button>
            <button type="button" id="adminBioUsePassword" class="ghost-link" style="justify-content:center;">Usar a senha</button>
        </div>
        <% } %>

        <form method="POST" action="/admin/login" class="stack-form">
            <label class="password-field">
                <div class="password-wrapper">
                    <input
                        placeholder="Senha"
                        type="password"
                        id="adminPassword"
                        name="password"
                        required
                        autocomplete="current-password"
                    >
                    <button
                        type="button"
                        class="toggle-password"
                        data-target="adminPassword"
                        aria-label="Mostrar senha"
                        title="Mostrar senha"
                    >👁</button>
                </div>
            </label>
            <button type="submit">Entrar</button>
        </form>

        <div class="admin-recovery-links">
            <a href="/admin/forgot">Esqueci a senha</a>
            <a href="/admin/emergency-login">Entrar com código</a>
        </div>

        <a href="/" class="back-link nav-action back">Voltar para a página inicial</a>
    </div>

    <script src="/transitions.js"></script>
    <script src="/toast.js"></script>
    <script src="/back.js"></script>
    <script>
    (function () {
        const pw = document.getElementById('adminPassword');
        if (pw) {
            try {
                pw.focus({ preventScroll: true });
            } catch (e) {
                pw.focus();
            }
        }

        document.querySelectorAll('.toggle-password').forEach(btn => {
            btn.addEventListener('click', function () {
                const input = document.getElementById(this.dataset.target);
                if (!input) return;

                const showing = input.type === 'text';
                input.type = showing ? 'password' : 'text';
                this.classList.toggle('is-visible', !showing);
                this.setAttribute('aria-label', showing ? 'Mostrar senha' : 'Ocultar senha');
                this.title = showing ? 'Mostrar senha' : 'Ocultar senha';
                this.textContent = showing ? '👁' : '🙈';
            });
        });
    })();
    </script>
    <% if (typeof webauthn !== 'undefined' && webauthn.enabled) { %>
    <script src="/webauthn.js?v=3"></script>
    <script>
    (function () {
        var api = window.AvaliWebAuthn;
        var admin = api && api.admin;
        var panel = document.getElementById('adminBioPanel');
        var form = document.querySelector('form[action="/admin/login"]');
        if (!admin || !panel || !form) return;

        var rpID = <%- safeJson(webauthn.rpID) %>;
        if (!api.isUsableHere(rpID)) return;

        // Depois de entrar com a senha, o painel oferece ativar a biometria (aviso único)
        form.addEventListener('submit', function () {
            try { sessionStorage.setItem('avaliAdminJustLoggedIn', '1'); } catch (e) {}
        });

        // Só oferece a biometria em aparelho onde o admin já a ativou
        if (!admin.hasDevice()) return;

        var bioBtn = document.getElementById('adminBioBtn');
        var usePassword = document.getElementById('adminBioUsePassword');

        function showPasswordForm() {
            panel.style.display = 'none';
            form.style.display = '';
            var pw = document.getElementById('adminPassword');
            if (pw) { try { pw.focus({ preventScroll: true }); } catch (e) { pw.focus(); } }
        }

        form.style.display = 'none';
        panel.style.display = '';

        usePassword.addEventListener('click', showPasswordForm);

        bioBtn.addEventListener('click', function () {
            bioBtn.disabled = true;
            bioBtn.textContent = 'Aguardando biometria...';

            admin.login().then(function (url) {
                try { sessionStorage.removeItem('avaliAdminJustLoggedIn'); } catch (e) {}
                window.location.href = url;
            }).catch(function (error) {
                bioBtn.disabled = false;
                bioBtn.textContent = 'Entrar com biometria';
                // 401: a chave não vale mais (removida/revogada/senha do admin trocada). Volta para a senha.
                if (error && error.serverSide && error.status === 401) {
                    admin.forget();
                    showPasswordForm();
                }
                if (window.showToast) showToast(api.friendlyError(error), 'error');
            });
        });
    })();
    </script>
    <% } %>
    <script src="/theme.js"></script>
</body>
</html>
