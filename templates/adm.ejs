<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administração | Fênix Dança</title>
    <script>
    (function () {
      try {
        var t = localStorage.getItem('fenix-theme');
        if (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          t = 'dark';
        }
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
    </script>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/adm.css?v=3">
    <link rel="icon" href="/images/icons8-fenix-cute-color-70.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="admin-body admin-dashboard-body">
    <%
        const totalTurmas = turmas.length;
        const totalTeachers = teachers.length;
        const totalCandidates = allCandidates.length;
        const totalActiveSessions = activeSessions.length;
        const totalHistory = typeof history !== 'undefined' && history ? history.length : 0;
        const evaluatorsOnline = activeStatus && typeof activeStatus.activeCount !== 'undefined' ? activeStatus.activeCount : 0;
        const latestActiveSession = activeSessions && activeSessions.length ? activeSessions[0] : null;
    %>

    <div class="admin-app">
        <aside class="admin-sidebar" id="adminSidebar" aria-label="Navegação administrativa">
            <a href="#dashboard" class="brand-lockup">
                <img src="/images/icons8-fenix-cute-color-96.png" alt="Fênix Dança">
                <span>
                    <strong>Fênix Dança</strong>
                    <small>Secretaria</small>
                </span>
            </a>

            <nav class="sidebar-nav">
                <a href="#dashboard" data-tab="dashboard" class="is-active"><span class="nav-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-5v-6H10v6H5a1 1 0 0 1-1-1v-9.5z"/></svg></span>Home</a>
                <a href="#audicao" data-tab="audicao"><span class="nav-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 5v2M12 17v2M5 12H3M21 12h-2M6.5 6.5l1.4 1.4M16.1 16.1l1.4 1.4M6.5 17.5l1.4-1.4M16.1 7.9l1.4-1.4"/></svg></span>Audição</a>
                <a href="#alunos" data-tab="alunos"><span class="nav-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="3"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a3 3 0 0 1 0 5.74"/></svg></span>Alunos</a>
                <a href="#professores" data-tab="professores"><span class="nav-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4z"/><path d="M4 20a8 8 0 0 1 16 0M18 8v4M20 10h-4"/></svg></span>Professores</a>
                <a href="#turmas" data-tab="turmas"><span class="nav-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 10h18M8 4v14"/></svg></span>Turmas</a>
                <a href="#historico" data-tab="historico"><span class="nav-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/></svg></span>Histórico</a>
            </nav>

            <div class="sidebar-status">
                <span class="status-dot <%= totalActiveSessions ? 'online' : '' %>"></span>
                <div>
                    <strong><%= totalActiveSessions ? 'Audição ao vivo' : 'Sem sessão ativa' %></strong>
                    <small><%= totalActiveSessions %> sessão(ões) em andamento</small>
                </div>
            </div>
        </aside>
        <div class="sidebar-backdrop" id="adminSidebarBackdrop" hidden></div>

        <main class="admin-main">
            <header class="admin-topbar">
                <button type="button"
                        class="sidebar-toggle"
                        id="adminSidebarToggle"
                        aria-label="Abrir menu"
                        aria-expanded="false"
                        aria-controls="adminSidebar">
                    <span></span><span></span><span></span>
                </button>
                <div>
                    <p class="breadcrumb">Secretaria Administrativa</p>
                    <h1 id="adminPageTitle">Painel Geral</h1>
                </div>

                <label class="global-search" aria-label="Busca administrativa">
                    <span>⌕</span>
                    <input id="adminSearch" type="search" placeholder="Buscar aluno, turma ou professor...">
                </label>

                <div class="topbar-actions">
                    <a href="/" class="ghost-link nav-action back">Início</a>
                    <form action="/admin/logout" method="POST" style="display:inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="danger nav-action exit">Sair</button>
                    </form>
                </div>
            </header>

            <% if (typeof message !== 'undefined' && message) { %>
                <div id="toast-data"
                     data-message="<%= message.text %>"
                     data-type="<%= message.type === 'success' ? 'success' : 'error' %>"
                     style="display:none"></div>
                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        const dataEl = document.getElementById('toast-data');
                        if (window.showToast && dataEl) {
                            showToast(dataEl.dataset.message, dataEl.dataset.type);
                        }
                    });
                </script>
            <% } %>

            <div class="tab-panel is-active" data-tab-panel="dashboard" id="dashboard">
                <section class="kpi-grid" aria-label="Resumo do sistema">
                    <article class="kpi-card" onclick="window.location.hash='#turmas'" style="cursor:pointer;">
                        <span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 10h18M8 4v14"/></svg></span>
                        <strong><%= totalTurmas %></strong>
                        <small>Turmas</small>
                    </article>
                    <article class="kpi-card" onclick="window.location.hash='#alunos'" style="cursor:pointer;">
                        <span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="3"/><path d="M3 21v-2a6 6 0 0 1 12 0v2M16 11a3 3 0 1 0 0-6M18 13a4 4 0 0 1 3 4v4"/></svg></span>
                        <strong><%= totalCandidates %></strong>
                        <small>Alunos</small>
                    </article>
                    <article class="kpi-card" onclick="window.location.hash='#professores'" style="cursor:pointer;">
                        <span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="7" r="3"/><path d="M4 21a8 8 0 0 1 16 0M18 8v4M20 10h-4"/></svg></span>
                        <strong><%= totalTeachers %></strong>
                        <small>Professores</small>
                    </article>
                    <article class="kpi-card live" onclick="window.location.hash='#audicao'" style="cursor:pointer;">
                        <span class="kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m12 3 9 17H3L12 3z"/><path d="M12 9v5M12 17h.01"/></svg></span>
                        <strong><%= totalActiveSessions %></strong>
                        <small>Sessões ativas</small>
                    </article>
                </section>

                <section class="dashboard-grid">
                    <article class="panel quick-panel" style="grid-column: 1 / -1;">
                        <div class="section-heading">
                            <div>
                                <p class="eyebrow">Atalho</p>
                                <h2>Ações rápidas</h2>
                            </div>
                        </div>
                        <div class="quick-actions">
                            <a href="#turmas" data-tab="turmas" class="quick-action">Nova turma</a>
                            <a href="#professores" data-tab="professores" class="quick-action">Novo professor</a>
                            <a href="#alunos" data-tab="alunos" class="quick-action">Novo aluno</a>
                            <a href="#audicao" data-tab="audicao" class="quick-action">Gerar PIN</a>
                        </div>
                        <div class="activity-feed">
                            <h3>Estado atual</h3>
                            <p><strong><%= evaluatorsOnline %></strong> avaliador(es) online agora.</p>
                            <p><strong><%= totalHistory %></strong> histórico(s) oficial(is) arquivado(s).</p>
                            <% activeSessions.forEach(session => { %>
                                <a href="/results?turmaId=<%= session.turma_id %>">Painel ao vivo: <%= session.turma_name %></a>
                            <% }) %>
                        </div>
                    </article>
                </section>
            </div>

            <section class="tab-panel panel admin-module" data-tab-panel="audicao" id="audicao" hidden>
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Audição</p>
                        <h2>Gerenciar sessões e PIN</h2>
                        <p class="panel-copy">Gere PINs para liberar a avaliação para os professores ou encerre sessões em andamento.</p>
                    </div>
                </div>

                <div class="audicao-layout">
                    <!-- COLUNA ESQUERDA: card do PIN -->
                    <article class="live-session-card">
                        <div class="section-heading light">
                            <span class="live-pulse"></span>
                            <div>
                                <p class="eyebrow">Audição</p>
                                <h2><%= latestActiveSession ? 'Audição em andamento' : 'Nenhuma audição ativa' %></h2>
                            </div>
                        </div>

                        <% if (latestActiveSession) { %>
                            <div class="pin-hero">
                                <span>PIN</span>
                                <strong id="activePin"><%= latestActiveSession.code || sessionCode %></strong>
                                <small><%= latestActiveSession.turma_name || currentTurmaName %></small>
                            </div>
                            <div class="hero-actions">
                                <button type="button" class="btn-light" data-copy-pin="<%= latestActiveSession.code || sessionCode %>">Copiar PIN</button>
                                <a href="/results?turmaId=<%= latestActiveSession.turma_id || currentTurmaId %>" class="btn-light">Ver ao vivo</a>
                            </div>
                        <% } else { %>
                            <p class="light-copy">Gere um PIN para liberar a avaliação da turma aos professores.</p>
                        <% } %>

                        <form action="/admin/generate-code" method="POST" class="session-form compact-form">
                            <label>
                                Turma da sessão
                                <select name="turmaId" required>
                                    <option value="">Selecione uma turma...</option>
                                    <% turmas.forEach(t => { %>
                                        <option value="<%= t.id %>"><%= t.name %> (Prof. <%= t.teacher_name %>)</option>
                                    <% }) %>
                                </select>
                            </label>
                            <button type="submit">Gerar PIN</button>
                        </form>

                        <% if (latestActiveSession) { %>
                            <form action="/admin/end-session" method="POST" class="end-session-form">
                                <button type="submit" class="danger">Encerrar sessão atual</button>
                            </form>
                        <% } %>
                    </article>

                    <!-- COLUNA DIREITA: fechar semestre -->
                    <aside class="close-semester-card">
                        <p class="eyebrow">Encerramento</p>
                        <h3>Fechar semestre</h3>
                        <p>
                            Terminou a audição desta turma? Feche o semestre para
                            <strong>arquivar os resultados</strong> no histórico e
                            <strong>reiniciar chamadas e percentuais</strong> de presença.
                        </p>

                        <% if (totalActiveSessions > 0) { %>
                            <button type="button" class="btn-close-semester" id="btnOpenCloseSemesterAudicao">
                                Fechar semestre
                            </button>
                            <p class="hint-mini">Turmas ativas serão listadas na confirmação.</p>
                        <% } else { %>
                            <button type="button" class="btn-close-semester is-disabled" disabled>
                                Fechar semestre
                            </button>
                            <p class="hint-mini">Disponível somente com audição ativa.</p>
                        <% } %>
                    </aside>
                </div>
            </section>

            <section class="tab-panel panel admin-module" data-tab-panel="alunos" id="alunos" hidden>
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Alunos</p>
                        <h2>Gerenciar alunos por turma</h2>
                        <p class="panel-copy"><%= totalCandidates %> aluno(s) cadastrados em <%= totalTurmas %> turma(s).</p>
                    </div>
                </div>

                <form action="/admin/candidate/add" method="POST" class="candidate-form form-card">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label>
                        Nome completo
                        <input type="text" name="name" required placeholder="Nome do aluno">
                    </label>
                    <label>
                        Gênero
                        <select name="gender" required>
                            <option value="male">Cavalheiro</option>
                            <option value="female">Dama</option>
                        </select>
                    </label>
                    <label>
                        Status inicial
                        <input type="text" name="status" value="Bolsista" placeholder="Bolsista">
                    </label>
                    <label>
                        Turma
                        <select name="turmaId" required>
                            <option value="">Selecione uma turma...</option>
                            <% turmas.forEach(t => { %>
                                <option value="<%= t.id %>"><%= t.name %></option>
                            <% }) %>
                        </select>
                    </label>
                    <button type="submit">Adicionar aluno</button>
                </form>

                <article class="form-card bulk-candidates">
                    <h3>Cadastro em lote</h3>
                    <p class="panel-copy">Um nome por linha. Linhas vazias são ignoradas.</p>

                    <label>
                        Turma
                        <select name="bulkTurmaId" id="bulkTurmaId" required>
                            <option value="">Selecione uma turma...</option>
                            <% turmas.forEach(t => { %>
                                <option value="<%= t.id %>"><%= t.name %></option>
                            <% }) %>
                        </select>
                    </label>
                    <label>
                        Gênero padrão
                        <select id="bulkGender">
                            <option value="female">Dama</option>
                            <option value="male">Cavalheiro</option>
                        </select>
                    </label>
                    <label>
                        Status
                        <select id="bulkStatus">
                            <option value="Bolsista">Bolsista</option>
                            <option value="Auxiliar">Auxiliar</option>
                        </select>
                    </label>
                    <label>
                        Lista de nomes
                        <textarea id="bulkNames" rows="8" placeholder="Maria Silva&#10;João Santos&#10;Ana Costa"></textarea>
                    </label>
                    <button type="button" id="bulkAddBtn">Adicionar todos</button>
                    <p class="hint-mini" id="bulkHint"></p>
                </article>

                <% if (turmas.length === 0) { %>
                    <div class="empty-state">
                        <p>Nenhuma turma cadastrada ainda.</p>
                        <p>Crie uma turma primeiro na seção Turmas.</p>
                    </div>
                <% } else { %>
                    <div class="turmas-grid searchable-group">
                        <% turmas.forEach(t => {
                            const alunosCount = allCandidates.filter(c => c.turma_id === t.id).length;
                        %>
                            <article class="turma-card searchable-card" data-search="<%= `${t.name} ${t.teacher_name || ''}`.toLowerCase() %>">
                                <div class="card-topline">
                                    <span>Turma</span>
                                    <strong class="turma-count" data-count><%= alunosCount %> aluno<%= alunosCount !== 1 ? 's' : '' %></strong>
                                </div>
                                <h3><%= t.name %></h3>
                                <p>Responsável: <%= t.teacher_name || 'Não definido' %></p>
                                <button type="button" class="ghost-link btn-ver-alunos"
                                        data-turma-id="<%= t.id %>" data-turma-name="<%= t.name %>">
                                    Ver alunos
                                </button>
                                <div class="alunos-lista-simples" id="lista-alunos-<%= t.id %>" hidden>
                                    <div class="lista-loading">Carregando...</div>
                                </div>
                            </article>
                        <% }) %>
                    </div>
                <% } %>
            </section>

            <section class="tab-panel panel admin-module" data-tab-panel="professores" id="professores" hidden>
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Equipe</p>
                        <h2>Gerenciar professores</h2>
                        <p class="panel-copy"><%= totalTeachers %> professor(es) cadastrado(s).</p>
                    </div>
                </div>

                <form action="/admin/teacher/add" method="POST" class="candidate-form form-card">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label>
                        Nome completo
                        <input type="text" name="name" required placeholder="Nome do professor">
                    </label>
                    <label>
                        Senha inicial
                        <input type="password" name="password" required placeholder="Defina uma senha" autocomplete="new-password">
                    </label>
                    <button type="submit">Adicionar professor</button>
                </form>

                <div class="person-grid searchable-group">
                    <% teachers.forEach(t => { %>
                        <article class="person-card searchable-card" data-search="<%= t.name.toLowerCase() %>">
                            <div>
                                <span class="avatar-chip"><%= t.name.charAt(0).toUpperCase() %></span>
                                <h3><%= t.name %></h3>
                                <p>Professor avaliador</p>
                            </div>
                            <button type="button" class="ghost-link" data-reset-teacher="<%= t.id %>" data-reset-name="<%= t.name %>">
                                Gerar código de reset
                            </button>
                                                        <form action="/admin/teacher/delete" method="POST" class="js-confirm-form"
                                                                    data-confirm-title="Remover professor"
                                                                    data-confirm-message="Tem certeza que deseja remover o professor <%= t.name %>?">
                                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="teacherId" value="<%= t.id %>">
                                <button type="submit" class="danger ghost-danger">Remover</button>
                            </form>
                        </article>
                    <% }) %>
                </div>
            </section>

            <section class="tab-panel panel admin-module" data-tab-panel="turmas" id="turmas" hidden>
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Turmas</p>
                        <h2>Gerenciar turmas</h2>
                        <p class="panel-copy"><%= totalTurmas %> turma(s) cadastrada(s).</p>
                    </div>
                </div>

                <form action="/admin/turma/add" method="POST" class="candidate-form form-card">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label>
                        Nome da turma
                        <input type="text" name="name" required placeholder="Ex: João Antônio 2024.1">
                    </label>
                    <label>
                        Professor responsável
                        <select name="teacherId" required>
                            <option value="">Selecione...</option>
                            <% teachers.forEach(t => { %>
                                <option value="<%= t.id %>"><%= t.name %></option>
                            <% }) %>
                        </select>
                    </label>
                    <label>
                        Ritmos Avaliados
                        <input type="text" name="ritmosAvaliados" placeholder="Ex: 1.Forró - 2.Bolero - 3.Zouk">
                    </label>
                    <button type="submit">Criar turma</button>
                </form>

                <div class="management-grid searchable-group">
                    <% turmas.forEach(t => {
                        const alunosCount = allCandidates.filter(c => c.turma_id === t.id).length;
                    %>
                        <article class="management-card searchable-card" data-search="<%= `${t.name} ${t.teacher_name || ''}`.toLowerCase() %>">
                            <div class="card-topline">
                                <span>Turma</span>
                                <strong><%= alunosCount %> aluno<%= alunosCount !== 1 ? 's' : '' %></strong>
                            </div>
                            <h3><%= t.name %></h3>
                            <p>Responsável: <%= t.teacher_name || 'Não definido' %></p>
                            <div class="card-actions">
                                <a href="/admin/turma/<%= t.id %>" class="ghost-link">Alunos</a>
                                <button type="button" onclick="document.getElementById('assign-<%= t.id %>').showModal()" class="ghost-link">Vincular</button>
                            </div>
                                                        <form action="/admin/turma/delete" method="POST" class="js-confirm-form"
                                                                    data-confirm-title="Excluir turma"
                                                                    data-confirm-message="Excluir &quot;<%= t.name %>&quot;? <%= alunosCount %> aluno(s) serão desvinculado(s). Esta ação não pode ser desfeita.">
                                                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="turmaId" value="<%= t.id %>">
                                <button type="submit" class="danger ghost-danger full-width">Excluir turma</button>
                            </form>
                        </article>

                        <dialog id="assign-<%= t.id %>">
                            <h3>Vincular alunos à <%= t.name %></h3>
                            <form action="/admin/turma/assign" method="POST">
                                <input type="hidden" name="turmaId" value="<%= t.id %>">
                                <div class="assign-list">
                                    <% allCandidates.forEach(c => { %>
                                        <label class="assign-option">
                                            <input type="checkbox" name="candidates" value="<%= c.id %>" <%= c.turma_id == t.id ? 'checked' : '' %> class="assign-checkbox">
                                            <span class="checkbox-visual" aria-hidden="true"></span>
                                            <span><%= c.name %></span>
                                        </label>
                                    <% }) %>
                                </div>
                                <div class="modal-actions">
                                    <button type="button" onclick="this.closest('dialog').close()" class="ghost-link">Cancelar</button>
                                    <button type="submit">Salvar</button>
                                </div>
                            </form>
                        </dialog>
                    <% }) %>
                </div>
            </section>

            <section class="tab-panel panel admin-module history-module" data-tab-panel="historico" id="historico" hidden>
                <% function formatHistDate(value) {
                    if (!value) return '';
                    const date = new Date(value);
                    if (Number.isNaN(date.getTime())) return String(value);
                    return date.toLocaleString('pt-BR', {
                        day: '2-digit',
                        month: '2-digit',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit',
                    });
                } %>
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Arquivo</p>
                        <h2>Histórico oficial</h2>
                        <p class="panel-copy">Últimas avaliações arquivadas. Exportações usam o snapshot congelado.</p>
                    </div>
                    <a href="/results/history" class="ghost-link">Ver histórico</a>
                </div>

                <% const historyList = (typeof history !== 'undefined' && history) ? history.slice(0, 8) : []; %>
                <% if (historyList.length === 0) { %>
                    <div class="empty-state">
                        <p>Nenhuma audição arquivada ainda.</p>
                        <p>Feche um semestre em <a href="#audicao" data-tab="audicao">Audição</a> para gerar histórico.</p>
                    </div>
                <% } else { %>
                    <div class="history-list">
                        <% historyList.forEach(h => { %>
                            <article class="history-row">
                                <div>
                                    <strong><%= h.title || h.turma_name || ('Evento #' + h.id) %></strong>
                                    <small>
                                        <%= formatHistDate(h.closed_at || h.created_at) %>
                                        <% if (h.turma_name) { %> · <%= h.turma_name %><% } %>
                                    </small>
                                </div>
                                <div class="history-actions">
                                    <a class="ghost-link" href="/results/history/<%= h.id %>">Abrir</a>
                                    <a class="ghost-link" href="/export_pdf/history/<%= h.id %>">PDF</a>
                                    <a class="ghost-link" href="/export_excel/history/<%= h.id %>">Excel</a>
                                </div>
                            </article>
                        <% }) %>
                    </div>
                <% } %>
            </section>
        </main>
    </div>

    <% if (totalActiveSessions > 0) { %>
    <dialog id="closeSemesterModal" class="admin-modal">
        <form method="POST" action="/admin/close-semester" id="closeSemesterForm">
            <% activeSessions.forEach(session => { %>
                <input type="hidden" name="turmaIds" value="<%= session.turma_id %>">
            <% }) %>
            <% if (typeof csrfToken !== 'undefined') { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>

            <div class="modal-header danger">
                <h3>Fechar semestre</h3>
                <button type="button" class="modal-close" data-close-modal aria-label="Fechar">×</button>
            </div>

            <div class="modal-body">
                <p class="modal-lead">Esta ação é <strong>irreversível</strong> para o ciclo atual. Confira o que será feito:</p>

                <ul class="modal-checklist">
                    <li>Arquivar os resultados oficiais no <strong>histórico</strong></li>
                    <li>Encerrar as sessões de audição ativas</li>
                    <li>Reiniciar <strong>chamadas e percentuais de presença</strong> das turmas abaixo</li>
                </ul>

                <div class="modal-turmas">
                    <span class="modal-label">Turmas que serão fechadas</span>
                    <ul>
                        <% activeSessions.forEach(session => { %>
                            <li>
                                <strong><%= session.turma_name %></strong>
                                <span>PIN <%= session.code %></span>
                            </li>
                        <% }) %>
                    </ul>
                </div>

                <p class="modal-warning">Só confirme se a audição realmente terminou e as notas já foram consolidadas.</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancel" data-close-modal>Cancelar</button>
                <button type="submit" class="btn-danger-confirm">Confirmar fechamento</button>
            </div>
        </form>
    </dialog>
    <% } %>

    <dialog id="confirmModal" class="admin-modal">
        <form method="dialog" id="confirmModalForm">
            <div class="modal-header danger">
                <h3 id="confirmModalTitle">Confirmar ação</h3>
            </div>
            <p id="confirmModalMessage" class="modal-body-text"></p>
            <div class="modal-actions">
                <button type="button" class="ghost-link" id="confirmModalCancel">Cancelar</button>
                <button type="submit" class="danger" id="confirmModalOk">Confirmar</button>
            </div>
        </form>
    </dialog>

    <dialog id="resetCodeModal" class="admin-modal">
        <div class="modal-header">
            <h3>Código de reset</h3>
        </div>
        <p id="resetCodeTeacher" class="modal-body-text"></p>
        <p class="pin-hero"><strong id="resetCodePin">-----</strong></p>
        <p class="hint-mini">Válido por 30 minutos. Envie ao professor pelo WhatsApp ou pessoalmente.</p>
        <div class="modal-actions">
            <button type="button" id="resetCodeCopy">Copiar</button>
            <button type="button" class="ghost-link" onclick="this.closest('dialog').close()">Fechar</button>
        </div>
    </dialog>

    <script src="/transitions.js?v=2"></script>
    <script src="/toast.js?v=2"></script>
    <script>
        document.querySelectorAll('form[method="POST"], form[method="post"]').forEach((form) => {
            if (form.querySelector('input[name="_csrf"]')) return;
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = '_csrf';
            input.value = <%- JSON.stringify(csrfToken) %>;
            form.prepend(input);
        });

        (function () {
            const app = document.querySelector('.admin-app');
            const toggle = document.getElementById('adminSidebarToggle');
            const backdrop = document.getElementById('adminSidebarBackdrop');
            if (!app || !toggle) return;

            function setOpen(open) {
                app.classList.toggle('sidebar-open', open);
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
                if (backdrop) backdrop.hidden = !open;
            }

            toggle.addEventListener('click', () => {
                setOpen(!app.classList.contains('sidebar-open'));
            });

            if (backdrop) backdrop.addEventListener('click', () => setOpen(false));

            document.querySelectorAll('.sidebar-nav a').forEach((link) => {
                link.addEventListener('click', () => {
                    if (window.matchMedia('(max-width: 1100px)').matches) setOpen(false);
                });
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape') setOpen(false);
            });
        })();

        (function () {
            const forms = [
                { selector: 'form[action="/admin/candidate/add"]', tab: 'alunos', ok: 'Aluno adicionado.' },
                { selector: 'form[action="/admin/teacher/add"]', tab: 'professores', ok: 'Professor adicionado.' },
                { selector: 'form[action="/admin/turma/add"]', tab: 'turmas', ok: 'Turma criada.' },
            ];

            forms.forEach(({ selector, tab, ok }) => {
                const form = document.querySelector(selector);
                if (!form) return;

                form.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    const button = form.querySelector('button[type="submit"]');
                    if (button) button.disabled = true;

                    try {
                        const csrf = form.querySelector('input[name="_csrf"]')?.value || '';
                        const response = await fetch(form.action, {
                            method: 'POST',
                            body: new FormData(form),
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'X-CSRF-Token': csrf,
                            },
                            credentials: 'same-origin',
                            redirect: 'follow',
                        });

                        if (!response.ok) throw new Error('Falha ao salvar');
                        if (window.showToast) showToast(ok, 'success');
                        try {
                            sessionStorage.setItem('adminActiveTab', tab);
                            if (tab === 'alunos') sessionStorage.setItem('fenix-focus-candidate-name', '1');
                        } catch (error) {}
                        window.location.hash = tab;
                        window.setTimeout(() => window.location.reload(), 450);
                    } catch (error) {
                        console.error(error);
                        if (window.showToast) showToast('Não foi possível salvar. Tente de novo.', 'error');
                        if (button) button.disabled = false;
                    }
                });
            });
        })();

        (function () {
            const button = document.getElementById('bulkAddBtn');
            if (!button) return;

            button.addEventListener('click', async () => {
                const names = document.getElementById('bulkNames')?.value || '';
                const turmaId = document.getElementById('bulkTurmaId')?.value || '';
                const gender = document.getElementById('bulkGender')?.value || 'female';
                const status = document.getElementById('bulkStatus')?.value || 'Bolsista';
                const csrf = document.querySelector('input[name="_csrf"]')?.value || '';
                const hint = document.getElementById('bulkHint');

                if (!turmaId || !names.trim()) {
                    if (window.showToast) showToast('Informe a turma e ao menos um nome.', 'error');
                    return;
                }

                button.disabled = true;
                if (hint) hint.textContent = 'Adicionando alunos...';
                try {
                    const response = await fetch('/admin/candidate/bulk', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest',
                            'X-CSRF-Token': csrf,
                        },
                        credentials: 'same-origin',
                        body: JSON.stringify({ names, turmaId, gender, status, _csrf: csrf }),
                    });
                    const data = await response.json().catch(() => ({}));
                    if (!response.ok || !data.ok) throw new Error(data.message || 'Não foi possível cadastrar os alunos.');

                    if (window.showToast) showToast(data.message || 'Alunos adicionados.', 'success');
                    try { sessionStorage.setItem('adminActiveTab', 'alunos'); } catch (error) {}
                    window.location.hash = 'alunos';
                    window.setTimeout(() => window.location.reload(), 450);
                } catch (error) {
                    if (window.showToast) showToast(error.message, 'error');
                    if (hint) hint.textContent = '';
                    button.disabled = false;
                }
            });
        })();

        document.addEventListener('DOMContentLoaded', () => {
            const search = document.getElementById('adminSearch');
            const cards = document.querySelectorAll('.searchable-card');
            if (search && cards.length) {
                search.addEventListener('input', () => {
                    const term = search.value.trim().toLowerCase();
                    cards.forEach(card => {
                        const value = card.dataset.search || card.textContent.toLowerCase();
                        card.hidden = term && !value.includes(term);
                    });
                });
            }

            document.querySelectorAll('[data-copy-pin]').forEach(button => {
                button.addEventListener('click', async () => {
                    const pin = button.dataset.copyPin;
                    try {
                        await navigator.clipboard.writeText(pin);
                        if (window.showToast) showToast('PIN copiado.', 'success');
                    } catch (error) {
                        if (window.showToast) showToast('Não foi possível copiar o PIN.', 'error');
                    }
                });
            });

            if (sessionStorage.getItem('fenix-focus-candidate-name')) {
                sessionStorage.removeItem('fenix-focus-candidate-name');
                document.querySelector('form[action="/admin/candidate/add"] [name="name"]')?.focus();
            }
        });

        (function () {
            const modal = document.getElementById('closeSemesterModal');
            if (!modal) return;

            ['btnOpenCloseSemester', 'btnOpenCloseSemesterAudicao'].forEach(id => {
                const btn = document.getElementById(id);
                if (btn) {
                    btn.addEventListener('click', () => {
                        if (typeof modal.showModal === 'function') {
                            modal.showModal();
                        } else {
                            modal.setAttribute('open', '');
                        }
                    });
                }
            });

            modal.querySelectorAll('[data-close-modal]').forEach(btn => {
                btn.addEventListener('click', () => {
                    if (typeof modal.close === 'function') modal.close();
                    else modal.removeAttribute('open');
                });
            });

            // Fecha ao clicar no backdrop
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    if (typeof modal.close === 'function') modal.close();
                    else modal.removeAttribute('open');
                }
            });
        })();

        (function () {
            const modal = document.getElementById('confirmModal');
            const titleEl = document.getElementById('confirmModalTitle');
            const messageEl = document.getElementById('confirmModalMessage');
            const cancelButton = document.getElementById('confirmModalCancel');
            const form = document.getElementById('confirmModalForm');
            if (!modal || !form) return;

            let pendingForm = null;
            let pendingAction = null;

            window.openConfirmModal = ({ title, message, onConfirm }) => {
                pendingForm = null;
                pendingAction = onConfirm;
                if (titleEl) titleEl.textContent = title || 'Confirmar ação';
                if (messageEl) messageEl.textContent = message || 'Tem certeza?';
                if (typeof modal.showModal === 'function') modal.showModal();
                else modal.setAttribute('open', '');
            };

            document.querySelectorAll('form.js-confirm-form').forEach((sourceForm) => {
                sourceForm.addEventListener('submit', (event) => {
                    event.preventDefault();
                    pendingForm = sourceForm;
                    pendingAction = null;
                    if (titleEl) titleEl.textContent = sourceForm.dataset.confirmTitle || 'Confirmar ação';
                    if (messageEl) messageEl.textContent = sourceForm.dataset.confirmMessage || 'Tem certeza?';
                    if (typeof modal.showModal === 'function') modal.showModal();
                    else modal.setAttribute('open', '');
                });
            });

            function close() {
                pendingForm = null;
                pendingAction = null;
                if (typeof modal.close === 'function') modal.close();
                else modal.removeAttribute('open');
            }

            if (cancelButton) cancelButton.addEventListener('click', close);

            form.addEventListener('submit', (event) => {
                event.preventDefault();
                const sourceForm = pendingForm;
                const action = pendingAction;
                close();
                if (action) action();
                else if (sourceForm) HTMLFormElement.prototype.submit.call(sourceForm);
            });

            modal.addEventListener('click', (event) => {
                if (event.target === modal) close();
            });

            modal.addEventListener('cancel', () => {
                pendingForm = null;
                pendingAction = null;
            });
        })();

        (function () {
            const csrf = document.querySelector('input[name="_csrf"]')?.value || '';

            function escapeHtml(value) {
                return String(value)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;');
            }

            function formatGender(gender) {
                if (!gender) return '—';
                const value = String(gender).toLowerCase();
                if (value === 'male' || value === 'm' || value === 'cavalheiro') return 'Cavalheiro';
                if (value === 'female' || value === 'f' || value === 'dama') return 'Dama';
                return String(gender);
            }

            function updateTurmaCount(cardOrButton) {
                const card = cardOrButton.classList.contains('turma-card')
                    ? cardOrButton
                    : cardOrButton.closest('.turma-card');
                if (!card) return;

                const lista = card.querySelector('.alunos-lista-simples');
                const remaining = lista ? lista.querySelectorAll('.aluno-row').length : 0;
                const countElement = card.querySelector('.turma-count, .count, [data-count]');
                if (countElement) countElement.textContent = `${remaining} ${remaining === 1 ? 'aluno' : 'alunos'}`;
                if (lista && remaining === 0) lista.innerHTML = '<p class="empty-list">Nenhum aluno nesta turma.</p>';
            }

            document.querySelectorAll('.btn-ver-alunos').forEach((button) => {
                button.addEventListener('click', async () => {
                    const turmaId = button.dataset.turmaId;
                    const container = document.getElementById(`lista-alunos-${turmaId}`);
                    if (!container) return;

                    if (!container.hidden && container.dataset.loaded === '1') {
                        container.hidden = true;
                        button.textContent = 'Ver alunos';
                        return;
                    }

                    container.hidden = false;
                    button.textContent = 'Ocultar alunos';
                    container.innerHTML = '<div class="lista-loading">Carregando...</div>';

                    try {
                        const response = await fetch(`/admin/turma/${turmaId}/students-simple`, {
                            headers: { Accept: 'application/json' },
                            credentials: 'same-origin',
                        });
                        const data = await response.json();
                        if (!response.ok || !data.ok) throw new Error(data.error || 'Erro ao carregar alunos.');

                        if (!data.students.length) {
                            container.innerHTML = '<p class="empty-list">Nenhum aluno nesta turma.</p>';
                        } else {
                            container.innerHTML = data.students.map((student) => `
                                <div class="aluno-row" data-id="${student.id}">
                                    <span class="aluno-nome">${escapeHtml(student.name)}</span>
                                    <span class="aluno-meta">${escapeHtml(formatGender(student.gender))} · ${escapeHtml(student.status || '')}</span>
                                    <button type="button" class="btn-danger-sm btn-delete-candidate"
                                            data-id="${student.id}" data-name="${escapeHtml(student.name)}">
                                        Remover do sistema
                                    </button>
                                </div>
                            `).join('');
                        }
                        container.dataset.loaded = '1';
                    } catch (error) {
                        container.innerHTML = `<p class="error-list">${escapeHtml(error.message)}</p>`;
                    }
                });
            });

            document.addEventListener('click', (event) => {
                const button = event.target.closest('.btn-delete-candidate');
                if (!button || typeof window.openConfirmModal !== 'function') return;

                window.openConfirmModal({
                    title: 'Remover aluno do sistema',
                    message: `Remover permanentemente "${button.dataset.name || 'este aluno'}"? Esta ação não pode ser desfeita.`,
                    onConfirm: async () => {
                        try {
                            const turmaCard = button.closest('.turma-card');
                            const response = await fetch('/admin/candidate/delete', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'Accept': 'application/json',
                                    'X-CSRF-Token': csrf,
                                    'X-Requested-With': 'XMLHttpRequest',
                                },
                                credentials: 'same-origin',
                                body: JSON.stringify({ candidateId: button.dataset.id, _csrf: csrf }),
                            });
                            const data = await response.json();
                            if (!response.ok || !data.ok) throw new Error(data.error || 'Falha ao remover aluno.');
                            button.closest('.aluno-row')?.remove();
                            if (turmaCard) updateTurmaCount(turmaCard);
                            if (window.showToast) showToast(`${data.name || button.dataset.name} removido do sistema.`, 'success');
                        } catch (error) {
                            if (window.showToast) showToast(error.message, 'error');
                        }
                    },
                });
            });
        })();

        (function () {
            const modal = document.getElementById('resetCodeModal');
            const teacherEl = document.getElementById('resetCodeTeacher');
            const pinEl = document.getElementById('resetCodePin');
            const copyButton = document.getElementById('resetCodeCopy');
            if (!modal || !teacherEl || !pinEl) return;

            let currentPin = '';
            document.querySelectorAll('[data-reset-teacher]').forEach((button) => {
                button.addEventListener('click', async () => {
                    button.disabled = true;
                    try {
                        const csrf = document.querySelector('input[name="_csrf"]')?.value || '';
                        const response = await fetch('/admin/teacher/reset-code', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'X-Requested-With': 'XMLHttpRequest',
                                'X-CSRF-Token': csrf,
                            },
                            body: new URLSearchParams({ teacherId: button.dataset.resetTeacher, _csrf: csrf }),
                            credentials: 'same-origin',
                        });
                        const data = await response.json();
                        if (!response.ok || !data.ok) throw new Error(data.message || 'Não foi possível gerar o código.');
                        currentPin = data.pin;
                        teacherEl.textContent = `Professor: ${button.dataset.resetName}`;
                        pinEl.textContent = data.pin;
                        if (typeof modal.showModal === 'function') modal.showModal();
                        else modal.setAttribute('open', '');
                    } catch (error) {
                        if (window.showToast) showToast(error.message, 'error');
                    } finally {
                        button.disabled = false;
                    }
                });
            });

            copyButton?.addEventListener('click', async () => {
                try {
                    await navigator.clipboard.writeText(currentPin);
                    if (window.showToast) showToast('Código copiado.', 'success');
                } catch (error) {
                    if (window.showToast) showToast('Não foi possível copiar o código.', 'error');
                }
            });
        })();

        (function () {
            const links = document.querySelectorAll('.sidebar-nav a[data-tab]');
            const panels = document.querySelectorAll('[data-tab-panel]');
            const STORAGE_KEY = 'adminActiveTab';
            const TAB_TITLES = {
                dashboard: 'Painel Geral',
                audicao: 'Audição',
                alunos: 'Alunos',
                professores: 'Professores',
                turmas: 'Turmas',
                historico: 'Histórico'
            };

            function activateTab(tabId, persist) {
                if (!tabId) tabId = 'dashboard';

                // Se a aba não existir, cai no dashboard
                const exists = document.querySelector('[data-tab-panel="' + tabId + '"]');
                if (!exists) tabId = 'dashboard';

                links.forEach(link => {
                    link.classList.toggle('is-active', link.dataset.tab === tabId);
                });

                panels.forEach(panel => {
                    const active = panel.dataset.tabPanel === tabId;
                    panel.classList.toggle('is-active', active);
                    if (active) panel.removeAttribute('hidden');
                    else panel.setAttribute('hidden', '');
                });

                const titleEl = document.getElementById('adminPageTitle');
                if (titleEl) {
                    titleEl.textContent = TAB_TITLES[tabId] || 'Painel Geral';
                }

                if (persist !== false) {
                    try { sessionStorage.setItem(STORAGE_KEY, tabId); } catch (e) {}
                    if (location.hash.replace('#', '') !== tabId) {
                        history.replaceState(null, '', '#' + tabId);
                    }
                }
            }

            links.forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    activateTab(this.dataset.tab);
                });
            });

            // Intercepta qualquer clique em links com hash para abas (ex: Ações rápidas, KPIs, empty-states)
            document.addEventListener('click', (e) => {
                const anchor = e.target.closest('a[href^="#"]');
                if (anchor && !anchor.closest('.sidebar-nav')) {
                    const hash = anchor.getAttribute('href').replace('#', '');
                    if (['dashboard', 'audicao', 'alunos', 'professores', 'turmas', 'historico'].includes(hash)) {
                        activateTab(hash);
                    }
                }
            });

            // Ordem de prioridade: hash da URL > sessionStorage > dashboard
            const fromHash = (window.location.hash || '').replace('#', '');
            let fromStorage = '';
            try { fromStorage = sessionStorage.getItem(STORAGE_KEY) || ''; } catch (e) {}

            const initial = fromHash || fromStorage || 'dashboard';
            activateTab(initial, false);
            // Persiste o que realmente abriu
            try { sessionStorage.setItem(STORAGE_KEY, initial); } catch (e) {}

            window.addEventListener('hashchange', () => {
                activateTab((window.location.hash || '#dashboard').replace('#', ''));
            });

            // Antes de enviar qualquer form do admin, grava a aba atual
            document.querySelectorAll('form').forEach(form => {
                form.addEventListener('submit', function () {
                    const active = document.querySelector('.sidebar-nav a.is-active');
                    const tabId = active ? active.dataset.tab : 'dashboard';
                    try { sessionStorage.setItem(STORAGE_KEY, tabId); } catch (e) {}
                });
            });
        })();
    </script>
    <script src="/theme.js"></script>
    <script src="/back.js"></script>
</body>
</html>
