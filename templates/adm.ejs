<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administração | Fênix Dança</title>
    <link rel="stylesheet" href="/adm.css">
    <link rel="icon" href="/images/icons8-fenix-cute-color-70.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body class="admin-body">
    <main class="admin-shell">
        <!-- HEADER -->
        <header class="admin-header">
            <div style="display:flex; align-items:center; gap:12px;">
                <a href="/" class="ghost-link">Voltar</a>
            </div>

            <div style="text-align:center;">
                <span class="eyebrow">Painel Administrativo</span>
                <h1 style="margin:4px 0 0; font-size:1.5rem;">Secretaria Fênix</h1>
            </div>

            <div>
                <form action="/admin/logout" method="POST" style="margin:0;">
                    <button type="submit" class="danger" style="padding:8px 18px; border-radius:999px; font-size:0.88rem;">Sair</button>
                </form>
            </div>
        </header>

        <% if (typeof message !== 'undefined' && message) { %>
            <div id="toast-data" 
                 data-message="<%= message.text %>" 
                 data-type="<%= message.type === 'success' ? 'success' : 'error' %>" 
                 style="display:none"></div>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const dataEl = document.getElementById('toast-data');
                    if (window.showToast && dataEl) {
                        showToast(dataEl.dataset.message, dataEl.dataset.type);
                    }
                });
            </script>
        <% } %>

        <!-- SEÇÃO 1: SESSÃO DE AUDIÇÃO -->
        <details class="panel admin-accordion" open>
            <summary class="accordion-summary">
                <div>
                    <h2>🔑 Sessão de Audição</h2>
                    <p class="panel-copy">
                        Selecione a turma e gere o código de acesso. Compartilhe o código com os professores.
                    </p>
                </div>
                <span class="accordion-indicator"></span>
            </summary>
            <div class="accordion-content">

                <!-- Gerar Código -->
                <form action="/admin/generate-code" method="POST" class="session-form" style="margin-bottom: 20px;">
                    <div>
                        <label style="flex:1; min-width:240px;">
                            Turma da Sessão
                            <select name="turmaId" required>
                                <option value="">Selecione uma turma...</option>
                                <% turmas.forEach(t => { %>
                                    <option value="<%= t.id %>"><%= t.name %> (Prof. <%= t.teacher_name %>)</option>
                                <% }) %>
                            </select>
                        </label>
                        <button type="submit" style="margin-bottom:2px;">Gerar Código PIN</button>
                    </div>
                </form>

                <!-- PIN Display -->
                <% if (typeof sessionCode !== 'undefined' && sessionCode) { %>
                    <div class="pin-display">
                        <span class="pin-label">Código de Acesso Ativo</span>
                        <span class="pin-code"><%= sessionCode %></span>
                        <span class="pin-turma">Turma: <strong><%= currentTurmaName %></strong></span>
                    </div>
                <% } %>

                <!-- Encerrar Sessão -->
                <form action="/admin/end-session" method="POST" style="margin: 16px 0 0;">
                    <button type="submit" class="danger" style="font-size:0.88rem; padding:8px 16px;">
                        Encerrar Sessão Atual
                    </button>
                </form>

                <!-- Fechar Avaliação -->
                <form action="/admin/close-evaluation" method="POST" class="session-form" style="margin-top:20px; padding-top:20px; border-top:1px solid var(--line);">
                    <div>
                        <label style="flex:1; min-width:240px;">
                            Fechar avaliação oficial
                            <select name="turmaId" required>
                                <option value="">Selecione uma turma...</option>
                                <% turmas.forEach(t => { %>
                                    <option value="<%= t.id %>"><%= t.name %></option>
                                <% }) %>
                            </select>
                        </label>
                        <button type="submit" class="danger" 
                                style="margin-bottom:2px; background:var(--success); box-shadow:0 1px 3px rgba(5,150,105,0.2);"
                                onmouseover="this.style.background='#047857'"
                                onmouseout="this.style.background='var(--success)'"
                                onclick="return confirm('Fechar a avaliação grava um histórico imutável e encerra a sessão ativa. Continuar?')">
                            Fechar e salvar histórico
                        </button>
                    </div>
                </form>
            </div>
        </details>

        <!-- SEÇÃO 2: FECHAR SEMESTRE -->
        <details class="panel admin-accordion">
            <summary class="accordion-summary">
                <div>
                    <h2>📦 Fechar Semestre</h2>
                    <p class="panel-copy">
                        Selecione uma ou mais turmas para fechar o período. Isso arquiva o resultado atual e reinicia chamadas e percentuais.
                    </p>
                </div>
                <span class="accordion-indicator"></span>
            </summary>
            <div class="accordion-content">
                <form action="/admin/close-semester" method="POST" 
                      onsubmit="return confirm('Fechar o semestre gravará o histórico e reiniciará chamadas para as turmas selecionadas. Continuar?');">
                    <div style="max-height:280px; overflow:auto; margin-bottom:16px; display:grid; gap:10px; padding:4px;">
                        <% turmas.forEach(t => { %>
                            <label style="display:flex; gap:12px; align-items:center; padding:12px 14px; border-radius:var(--radius-sm); border:1.5px solid var(--line); cursor:pointer; transition:all 0.15s ease;"
                                   onmouseover="this.style.borderColor='#c7d2fe'; this.style.background='var(--primary-light)'"
                                   onmouseout="this.style.borderColor='var(--line)'; this.style.background=''">
                                <input type="checkbox" name="turmaIds" value="<%= t.id %>" style="width:20px; height:20px; accent-color:var(--primary); flex-shrink:0;">
                                <div style="flex:1;">
                                    <strong style="display:block; font-size:0.95rem;"><%= t.name %></strong>
                                    <span style="font-size:0.82rem; color:var(--muted); font-weight:500;">Prof: <%= t.teacher_name %></span>
                                </div>
                            </label>
                        <% }) %>
                    </div>
                    <div style="display:flex; justify-content:flex-end;">
                        <button type="submit" class="danger">Fechar Semestre Selecionado</button>
                    </div>
                </form>
            </div>
        </details>

        <!-- SEÇÃO 3: GERENCIAR ALUNOS -->
        <details class="panel admin-accordion">
            <summary class="accordion-summary">
                <div>
                    <h2>👨‍🎓 Gerenciar Alunos por Turma</h2>
                    <p class="panel-copy"><%= allCandidates.length %> aluno(s) cadastrados em <%= turmas.length %> turma(s).</p>
                </div>
                <span class="accordion-indicator"></span>
            </summary>
            <div class="accordion-content">

                <!-- Adicionar Aluno -->
                <form action="/admin/candidate/add" method="POST" class="candidate-form" style="margin-bottom: 28px;">
                    <label>
                        Nome Completo
                        <input type="text" name="name" required placeholder="Nome do aluno">
                    </label>
                    <label>
                        Gênero
                        <select name="gender" required>
                            <option value="male">Cavalheiro</option>
                            <option value="female">Dama</option>
                        </select>
                    </label>
                    <label>
                        Status Inicial
                        <input type="text" name="status" value="Bolsista" placeholder="Bolsista">
                    </label>
                    <label>
                        Turma
                        <select name="turmaId" required>
                            <option value="">Selecione uma turma...</option>
                            <% turmas.forEach(t => { %>
                                <option value="<%= t.id %>"><%= t.name %></option>
                            <% }) %>
                        </select>
                    </label>
                    <button type="submit" style="margin-bottom:2px;">Adicionar Aluno</button>
                </form>

                <% if (turmas.length === 0) { %>
                    <div class="empty-state">
                        <p>Nenhuma turma cadastrada ainda.</p>
                        <p>Crie uma turma primeiro na seção "Gerenciar Turmas".</p>
                    </div>
                <% } else { %>
                    <div class="turmas-grid">
                        <% turmas.forEach(t => { 
                            const alunosCount = allCandidates.filter(c => c.turma_id === t.id).length;
                        %>
                            <div class="turma-card" onclick="window.location.href='/admin/turma/<%= t.id %>'">
                                <h3><%= t.name %></h3>
                                <p>Responsável: <%= t.teacher_name || 'Não definido' %></p>
                                <div style="display:flex; gap:10px; align-items:center; margin-top:auto;">
                                    <span style="background:var(--primary-light); color:var(--primary); padding:5px 12px; border-radius:999px; font-size:0.8rem; font-weight:700;">
                                        <%= alunosCount %> aluno<%= alunosCount !== 1 ? 's' : '' %>
                                    </span>
                                    <span style="color:var(--primary); font-size:0.82rem; font-weight:600;">
                                        Ver alunos →
                                    </span>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </details>

        <!-- SEÇÃO 4: PROFESSORES -->
        <details class="panel admin-accordion">
            <summary class="accordion-summary">
                <div>
                    <h2>👨‍🏫 Gerenciar Professores</h2>
                    <p class="panel-copy"><%= teachers.length %> professor(es) cadastrado(s).</p>
                </div>
                <span class="accordion-indicator"></span>
            </summary>
            <div class="accordion-content">

                <form action="/admin/teacher/add" method="POST" class="candidate-form" style="margin-bottom: 20px;">
                    <label>
                        Nome Completo
                        <input type="text" name="name" required placeholder="Nome do professor">
                    </label>
                    <label>
                        Senha Inicial
                        <input type="password" name="password" required placeholder="Defina uma senha" autocomplete="new-password">
                    </label>
                    <button type="submit" style="margin-bottom:2px;">Adicionar Professor</button>
                </form>

                <div class="admin-table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Nome</th>
                                <th style="text-align:right;">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% teachers.forEach(t => { %>
                                <tr>
                                    <td><strong><%= t.name %></strong></td>
                                    <td style="text-align:right;">
                                        <form action="/admin/teacher/reset-password" method="POST" style="display:inline-flex; gap:8px; align-items:center; margin-right:12px;">
                                            <input type="hidden" name="teacherId" value="<%= t.id %>">
                                            <input type="password" name="newPassword" placeholder="Nova senha" style="width:140px; padding:8px 12px; font-size:0.85rem;" required autocomplete="new-password">
                                            <button type="submit" style="padding:8px 14px; font-size:0.85rem;">Redefinir</button>
                                        </form>

                                        <form action="/admin/teacher/delete" method="POST" style="display:inline;" 
                                              onsubmit="return confirm('Tem certeza que deseja remover o professor <%= t.name %>?');">
                                            <input type="hidden" name="teacherId" value="<%= t.id %>">
                                            <button type="submit" class="danger" style="padding:8px 14px; font-size:0.85rem;">Remover</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </details>

        <!-- SEÇÃO 5: TURMAS -->
        <details class="panel admin-accordion">
            <summary class="accordion-summary">
                <div>
                    <h2>🏫 Gerenciar Turmas</h2>
                    <p class="panel-copy"><%= turmas.length %> turma(s) cadastrada(s).</p>
                </div>
                <span class="accordion-indicator"></span>
            </summary>
            <div class="accordion-content">

                <form action="/admin/turma/add" method="POST" class="candidate-form" style="margin-bottom: 20px;">
                    <label>
                        Nome da Turma
                        <input type="text" name="name" required placeholder="Ex: João Antônio 2024.1">
                    </label>
                    <label>
                        Professor Responsável
                        <select name="teacherId" required>
                            <option value="">Selecione...</option>
                            <% teachers.forEach(t => { %>
                                <option value="<%= t.id %>"><%= t.name %></option>
                            <% }) %>
                        </select>
                    </label>
                    <label>
                        Senha da Turma
                        <input type="password" name="accessPassword" required placeholder="Senha compartilhada" autocomplete="new-password">
                    </label>
                    <button type="submit" style="margin-bottom:2px;">Criar Turma</button>
                </form>

                <div class="admin-table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Turma</th>
                                <th>Responsável</th>
                                <th>Senha</th>
                                <th style="text-align:right;">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% turmas.forEach(t => { %>
                                <tr>
                                    <td><strong><%= t.name %></strong></td>
                                    <td><%= t.teacher_name %></td>
                                    <td>
                                        <span class="tag" style="background:<%= t.has_access_password ? 'var(--success-light)' : 'var(--warning-light)' %>; 
                                                                       color:<%= t.has_access_password ? 'var(--success)' : 'var(--warning)' %>;
                                                                       border-color:<%= t.has_access_password ? '#a7f3d0' : '#fde68a' %>;">
                                            <%= t.has_access_password ? 'Configurada' : 'Pendente' %>
                                        </span>
                                    </td>
                                    <td style="text-align:right;">
                                        <button onclick="document.getElementById('assign-<%= t.id %>').showModal()" 
                                                class="ghost-link" style="padding:6px 12px; font-size:0.82rem; margin-right:6px;">Vincular Alunos</button>
                                        <button onclick="document.getElementById('password-<%= t.id %>').showModal()" 
                                                class="ghost-link" style="padding:6px 12px; font-size:0.82rem; margin-right:6px;">Trocar Senha</button>

                                        <form action="/admin/turma/delete" method="POST" style="display:inline;"
                                              onsubmit="return confirm('Tem certeza que deseja excluir a turma <%= t.name %>? Todos os alunos serão desvinculados.');">
                                            <input type="hidden" name="turmaId" value="<%= t.id %>">
                                            <button type="submit" class="danger" style="padding:6px 12px; font-size:0.82rem;">Excluir</button>
                                        </form>

                                        <!-- Modal Trocar Senha -->
                                        <dialog id="password-<%= t.id %>">
                                            <h3>Trocar senha da turma <%= t.name %></h3>
                                            <form action="/admin/turma/password" method="POST">
                                                <input type="hidden" name="turmaId" value="<%= t.id %>">
                                                <label>
                                                    Nova senha da turma
                                                    <input type="password" name="accessPassword" required placeholder="Nova senha compartilhada" autocomplete="new-password">
                                                </label>
                                                <div class="modal-actions">
                                                    <button type="button" onclick="this.closest('dialog').close()" class="ghost-link">Cancelar</button>
                                                    <button type="submit">Salvar senha</button>
                                                </div>
                                            </form>
                                        </dialog>

                                        <!-- Modal Vincular Alunos -->
                                        <dialog id="assign-<%= t.id %>">
                                            <h3>Vincular Alunos à <%= t.name %></h3>
                                            <form action="/admin/turma/assign" method="POST">
                                                <input type="hidden" name="turmaId" value="<%= t.id %>">
                                                <div style="max-height:360px; overflow:auto; margin:16px 0; display:grid; gap:8px;">
                                                    <% allCandidates.forEach(c => { %>
                                                        <label style="display:flex; gap:10px; align-items:center; padding:10px 12px; border-radius:var(--radius-sm); border:1.5px solid var(--line); cursor:pointer; transition:all 0.15s ease;"
                                                               onmouseover="this.style.borderColor='#c7d2fe'; this.style.background='var(--primary-light)'"
                                                               onmouseout="this.style.borderColor='var(--line)'; this.style.background=''">
                                                            <input type="checkbox" name="candidates" value="<%= c.id %>" <%= c.turma_id == t.id ? 'checked' : '' %> 
                                                                   style="width:18px; height:18px; accent-color:var(--primary); flex-shrink:0;">
                                                            <span style="font-weight:500; font-size:0.92rem;"><%= c.name %></span>
                                                        </label>
                                                    <% }) %>
                                                </div>
                                                <div class="modal-actions">
                                                    <button type="button" onclick="this.closest('dialog').close()" class="ghost-link">Cancelar</button>
                                                    <button type="submit">Salvar</button>
                                                </div>
                                            </form>
                                        </dialog>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </details>

        <!-- SEÇÃO 6: HISTÓRICO -->
        <details class="panel admin-accordion">
            <summary class="accordion-summary">
                <div>
                    <h2>📜 Histórico Oficial de Avaliações</h2>
                    <p class="panel-copy">Avaliações fechadas ficam congeladas aqui, mesmo que notas, presenças ou professores mudem depois.</p>
                </div>
                <a href="/results/history" class="ghost-link" style="padding:8px 16px; font-size:0.85rem;">Ver Histórico</a>
            </summary>
        </details>
    </main>

    <script src="/transitions.js?v=2"></script>
    <script src="/toast.js?v=2"></script>

</body>
</html>
