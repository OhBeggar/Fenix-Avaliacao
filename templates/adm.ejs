<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Administração | Fênix Dança</title>
    <script>
    (function () {
      try {
        var t = localStorage.getItem('fenix-theme');
        if (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          t = 'dark';
        }
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
    </script>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/adm.css?v=3">
    <link rel="icon" href="/images/icons8-fenix-cute-color-70.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="admin-body admin-dashboard-body">
    <%
        const totalTurmas = turmas.length;
        const totalTeachers = teachers.length;
        const totalCandidates = allCandidates.length;
        const totalActiveSessions = activeSessions.length;
        const totalHistory = typeof history !== 'undefined' && history ? history.length : 0;
        const evaluatorsOnline = activeStatus && typeof activeStatus.activeCount !== 'undefined' ? activeStatus.activeCount : 0;
        const latestActiveSession = activeSessions && activeSessions.length ? activeSessions[0] : null;
    %>

    <div class="admin-app">
        <aside class="admin-sidebar" aria-label="Navegação administrativa">
            <a href="#dashboard" class="brand-lockup">
                <img src="/images/icons8-fenix-cute-color-96.png" alt="Fênix Dança">
                <span>
                    <strong>Fênix Dança</strong>
                    <small>Secretaria</small>
                </span>
            </a>

            <nav class="sidebar-nav">
                <a href="#dashboard" data-tab="dashboard" class="is-active"><span>🏠</span>Home</a>
                <a href="#audicao" data-tab="audicao"><span>💃</span>Audição</a>
                <a href="#alunos" data-tab="alunos"><span>🧑🏻</span>Alunos</a>
                <a href="#professores" data-tab="professores"><span>🧑🏻‍🏫</span>Professores</a>
                <a href="#turmas" data-tab="turmas"><span>👥</span>Turmas</a>
                <a href="#semestre" data-tab="semestre"><span>📅</span>Semestre</a>
                <a href="#historico" data-tab="historico"><span>🧾</span>Histórico</a>
            </nav>

            <div class="sidebar-status">
                <span class="status-dot <%= totalActiveSessions ? 'online' : '' %>"></span>
                <div>
                    <strong><%= totalActiveSessions ? 'Audição ao vivo' : 'Sem sessão ativa' %></strong>
                    <small><%= totalActiveSessions %> sessão(ões) em andamento</small>
                </div>
            </div>
        </aside>

        <main class="admin-main">
            <header class="admin-topbar">
                <div>
                    <p class="breadcrumb">Secretaria Administrativa</p>
                    <h1>Painel Geral</h1>
                </div>

                <label class="global-search" aria-label="Busca administrativa">
                    <span>⌕</span>
                    <input id="adminSearch" type="search" placeholder="Buscar aluno, turma ou professor...">
                </label>

                <div class="topbar-actions">
                    <a href="/admin/login" class="ghost-link nav-action back">Voltar</a>
                    <form action="/admin/logout" method="POST">
                        <button type="submit" class="danger nav-action exit">Sair</button>
                    </form>
                </div>
            </header>

            <% if (typeof message !== 'undefined' && message) { %>
                <div id="toast-data"
                     data-message="<%= message.text %>"
                     data-type="<%= message.type === 'success' ? 'success' : 'error' %>"
                     style="display:none"></div>
                <script>
                    document.addEventListener('DOMContentLoaded', () => {
                        const dataEl = document.getElementById('toast-data');
                        if (window.showToast && dataEl) {
                            showToast(dataEl.dataset.message, dataEl.dataset.type);
                        }
                    });
                </script>
            <% } %>

            <div class="tab-panel is-active" data-tab-panel="dashboard" id="dashboard">
                <section class="kpi-grid" aria-label="Resumo do sistema">
                    <article class="kpi-card" onclick="window.location.hash='#turmas'" style="cursor:pointer;">
                        <span class="kpi-icon">👥</span>
                        <strong><%= totalTurmas %></strong>
                        <small>Turmas</small>
                    </article>
                    <article class="kpi-card" onclick="window.location.hash='#alunos'" style="cursor:pointer;">
                        <span class="kpi-icon">🧑🏻</span>
                        <strong><%= totalCandidates %></strong>
                        <small>Alunos</small>
                    </article>
                    <article class="kpi-card" onclick="window.location.hash='#professores'" style="cursor:pointer;">
                        <span class="kpi-icon">🧑🏻‍🏫</span>
                        <strong><%= totalTeachers %></strong>
                        <small>Professores</small>
                    </article>
                    <article class="kpi-card live" onclick="window.location.hash='#audicao'" style="cursor:pointer;">
                        <span class="kpi-icon">⚠️</span>
                        <strong><%= totalActiveSessions %></strong>
                        <small>Sessões ativas</small>
                    </article>
                </section>

                <section class="dashboard-grid">
                    <article class="panel quick-panel" style="grid-column: 1 / -1;">
                        <div class="section-heading">
                            <div>
                                <p class="eyebrow">Atalho</p>
                                <h2>Ações rápidas</h2>
                            </div>
                        </div>
                        <div class="quick-actions">
                            <a href="#turmas" data-tab="turmas" class="quick-action">Nova turma</a>
                            <a href="#professores" data-tab="professores" class="quick-action">Novo professor</a>
                            <a href="#alunos" data-tab="alunos" class="quick-action">Novo aluno</a>
                            <a href="#audicao" data-tab="audicao" class="quick-action">Gerar PIN</a>
                        </div>
                        <div class="activity-feed">
                            <h3>Estado atual</h3>
                            <p><strong><%= evaluatorsOnline %></strong> avaliador(es) online agora.</p>
                            <p><strong><%= totalHistory %></strong> histórico(s) oficial(is) arquivado(s).</p>
                            <% activeSessions.forEach(session => { %>
                                <a href="/results?turmaId=<%= session.turma_id %>">Painel ao vivo: <%= session.turma_name %></a>
                            <% }) %>
                        </div>
                    </article>
                </section>
            </div>

            <section class="tab-panel panel admin-module" data-tab-panel="audicao" id="audicao" hidden>
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Audição</p>
                        <h2>Gerenciar sessões e PIN</h2>
                        <p class="panel-copy">Gere PINs para liberar a avaliação para os professores ou encerre sessões em andamento.</p>
                    </div>
                </div>

                <div class="audicao-layout">
                    <!-- COLUNA ESQUERDA: card do PIN -->
                    <article class="live-session-card">
                        <div class="section-heading light">
                            <span class="live-pulse"></span>
                            <div>
                                <p class="eyebrow">Audição</p>
                                <h2><%= latestActiveSession ? 'Audição em andamento' : 'Nenhuma audição ativa' %></h2>
                            </div>
                        </div>

                        <% if (latestActiveSession) { %>
                            <div class="pin-hero">
                                <span>PIN</span>
                                <strong id="activePin"><%= latestActiveSession.code || sessionCode %></strong>
                                <small><%= latestActiveSession.turma_name || currentTurmaName %></small>
                            </div>
                            <div class="hero-actions">
                                <button type="button" class="btn-light" data-copy-pin="<%= latestActiveSession.code || sessionCode %>">Copiar PIN</button>
                                <a href="/results?turmaId=<%= latestActiveSession.turma_id || currentTurmaId %>" class="btn-light">Ver ao vivo</a>
                            </div>
                        <% } else { %>
                            <p class="light-copy">Gere um PIN para liberar a avaliação da turma aos professores.</p>
                        <% } %>

                        <form action="/admin/generate-code" method="POST" class="session-form compact-form">
                            <label>
                                Turma da sessão
                                <select name="turmaId" required>
                                    <option value="">Selecione uma turma...</option>
                                    <% turmas.forEach(t => { %>
                                        <option value="<%= t.id %>"><%= t.name %> (Prof. <%= t.teacher_name %>)</option>
                                    <% }) %>
                                </select>
                            </label>
                            <button type="submit">Gerar PIN</button>
                        </form>

                        <% if (latestActiveSession) { %>
                            <form action="/admin/end-session" method="POST" class="end-session-form">
                                <button type="submit" class="danger">Encerrar sessão atual</button>
                            </form>
                        <% } %>
                    </article>

                    <!-- COLUNA DIREITA: fechar semestre -->
                    <aside class="close-semester-card">
                        <p class="eyebrow">Encerramento</p>
                        <h3>Fechar semestre</h3>
                        <p>
                            Terminou a audição desta turma? Feche o semestre para
                            <strong>arquivar os resultados</strong> no histórico e
                            <strong>reiniciar chamadas e percentuais</strong> de presença.
                        </p>

                        <% if (totalActiveSessions > 0) { %>
                            <button type="button" class="btn-close-semester" id="btnOpenCloseSemesterAudicao">
                                Fechar semestre
                            </button>
                            <p class="hint-mini">Turmas ativas serão listadas na confirmação.</p>
                        <% } else { %>
                            <button type="button" class="btn-close-semester is-disabled" disabled>
                                Fechar semestre
                            </button>
                            <p class="hint-mini">Disponível somente com audição ativa.</p>
                        <% } %>
                    </aside>
                </div>
            </section>

            <section class="tab-panel panel admin-module" data-tab-panel="alunos" id="alunos" hidden>
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Alunos</p>
                        <h2>Gerenciar alunos por turma</h2>
                        <p class="panel-copy"><%= totalCandidates %> aluno(s) cadastrados em <%= totalTurmas %> turma(s).</p>
                    </div>
                </div>

                <form action="/admin/candidate/add" method="POST" class="candidate-form form-card">
                    <label>
                        Nome completo
                        <input type="text" name="name" required placeholder="Nome do aluno">
                    </label>
                    <label>
                        Gênero
                        <select name="gender" required>
                            <option value="male">Cavalheiro</option>
                            <option value="female">Dama</option>
                        </select>
                    </label>
                    <label>
                        Status inicial
                        <input type="text" name="status" value="Bolsista" placeholder="Bolsista">
                    </label>
                    <label>
                        Turma
                        <select name="turmaId" required>
                            <option value="">Selecione uma turma...</option>
                            <% turmas.forEach(t => { %>
                                <option value="<%= t.id %>"><%= t.name %></option>
                            <% }) %>
                        </select>
                    </label>
                    <button type="submit">Adicionar aluno</button>
                </form>

                <% if (turmas.length === 0) { %>
                    <div class="empty-state">
                        <p>Nenhuma turma cadastrada ainda.</p>
                        <p>Crie uma turma primeiro na seção Turmas.</p>
                    </div>
                <% } else { %>
                    <div class="turmas-grid searchable-group">
                        <% turmas.forEach(t => {
                            const alunosCount = allCandidates.filter(c => c.turma_id === t.id).length;
                        %>
                            <article class="turma-card searchable-card" data-search="<%= `${t.name} ${t.teacher_name || ''}`.toLowerCase() %>" onclick="window.location.href='/admin/turma/<%= t.id %>'">
                                <div class="card-topline">
                                    <span>Turma</span>
                                    <strong><%= alunosCount %> aluno<%= alunosCount !== 1 ? 's' : '' %></strong>
                                </div>
                                <h3><%= t.name %></h3>
                                <p>Responsável: <%= t.teacher_name || 'Não definido' %></p>
                                <span class="card-link">Ver alunos</span>
                            </article>
                        <% }) %>
                    </div>
                <% } %>
            </section>

            <section class="tab-panel panel admin-module" data-tab-panel="professores" id="professores" hidden>
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Equipe</p>
                        <h2>Gerenciar professores</h2>
                        <p class="panel-copy"><%= totalTeachers %> professor(es) cadastrado(s).</p>
                    </div>
                </div>

                <form action="/admin/teacher/add" method="POST" class="candidate-form form-card">
                    <label>
                        Nome completo
                        <input type="text" name="name" required placeholder="Nome do professor">
                    </label>
                    <label>
                        Senha inicial
                        <input type="password" name="password" required placeholder="Defina uma senha" autocomplete="new-password">
                    </label>
                    <button type="submit">Adicionar professor</button>
                </form>

                <div class="person-grid searchable-group">
                    <% teachers.forEach(t => { %>
                        <article class="person-card searchable-card" data-search="<%= t.name.toLowerCase() %>">
                            <div>
                                <span class="avatar-chip"><%= t.name.charAt(0).toUpperCase() %></span>
                                <h3><%= t.name %></h3>
                                <p>Professor avaliador</p>
                            </div>
                            <form action="/admin/teacher/reset-password" method="POST" class="mini-form">
                                <input type="hidden" name="teacherId" value="<%= t.id %>">
                                <input type="password" name="newPassword" placeholder="Nova senha" required autocomplete="new-password">
                                <button type="submit">Redefinir</button>
                            </form>
                            <form action="/admin/teacher/delete" method="POST" onsubmit="return confirm('Tem certeza que deseja remover o professor <%= t.name %>?');">
                                <input type="hidden" name="teacherId" value="<%= t.id %>">
                                <button type="submit" class="danger ghost-danger">Remover</button>
                            </form>
                        </article>
                    <% }) %>
                </div>
            </section>

            <section class="tab-panel panel admin-module" data-tab-panel="turmas" id="turmas" hidden>
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Turmas</p>
                        <h2>Gerenciar turmas</h2>
                        <p class="panel-copy"><%= totalTurmas %> turma(s) cadastrada(s).</p>
                    </div>
                </div>

                <form action="/admin/turma/add" method="POST" class="candidate-form form-card">
                    <label>
                        Nome da turma
                        <input type="text" name="name" required placeholder="Ex: João Antônio 2024.1">
                    </label>
                    <label>
                        Professor responsável
                        <select name="teacherId" required>
                            <option value="">Selecione...</option>
                            <% teachers.forEach(t => { %>
                                <option value="<%= t.id %>"><%= t.name %></option>
                            <% }) %>
                        </select>
                    </label>
                    <label>
                        Senha da turma
                        <input type="password" name="accessPassword" required placeholder="Senha compartilhada" autocomplete="new-password">
                    </label>
                    <label>
                        Ritmos Avaliados
                        <input type="text" name="ritmosAvaliados" placeholder="Ex: 1.Forró - 2.Bolero - 3.Zouk">
                    </label>
                    <button type="submit">Criar turma</button>
                </form>

                <div class="management-grid searchable-group">
                    <% turmas.forEach(t => {
                        const alunosCount = allCandidates.filter(c => c.turma_id === t.id).length;
                    %>
                        <article class="management-card searchable-card" data-search="<%= `${t.name} ${t.teacher_name || ''}`.toLowerCase() %>">
                            <div class="card-topline">
                                <span><%= t.has_access_password ? 'Senha configurada' : 'Senha pendente' %></span>
                                <strong><%= alunosCount %> aluno<%= alunosCount !== 1 ? 's' : '' %></strong>
                            </div>
                            <h3><%= t.name %></h3>
                            <p>Responsável: <%= t.teacher_name || 'Não definido' %></p>
                            <div class="card-actions">
                                <a href="/admin/turma/<%= t.id %>" class="ghost-link">Alunos</a>
                                <button type="button" onclick="document.getElementById('assign-<%= t.id %>').showModal()" class="ghost-link">Vincular</button>
                                <button type="button" onclick="document.getElementById('password-<%= t.id %>').showModal()" class="ghost-link">Senha</button>
                            </div>
                            <form action="/admin/turma/delete" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir a turma <%= t.name %>? Todos os alunos serão desvinculados.');">
                                <input type="hidden" name="turmaId" value="<%= t.id %>">
                                <button type="submit" class="danger ghost-danger full-width">Excluir turma</button>
                            </form>
                        </article>

                        <dialog id="password-<%= t.id %>">
                            <h3>Trocar senha da turma <%= t.name %></h3>
                            <form action="/admin/turma/password" method="POST">
                                <input type="hidden" name="turmaId" value="<%= t.id %>">
                                <label>
                                    Nova senha da turma
                                    <input type="password" name="accessPassword" required placeholder="Nova senha compartilhada" autocomplete="new-password">
                                </label>
                                <div class="modal-actions">
                                    <button type="button" onclick="this.closest('dialog').close()" class="ghost-link">Cancelar</button>
                                    <button type="submit">Salvar senha</button>
                                </div>
                            </form>
                        </dialog>

                        <dialog id="assign-<%= t.id %>">
                            <h3>Vincular alunos à <%= t.name %></h3>
                            <form action="/admin/turma/assign" method="POST">
                                <input type="hidden" name="turmaId" value="<%= t.id %>">
                                <div class="assign-list">
                                    <% allCandidates.forEach(c => { %>
                                        <label class="assign-option">
                                            <input type="checkbox" name="candidates" value="<%= c.id %>" <%= c.turma_id == t.id ? 'checked' : '' %> class="assign-checkbox">
                                            <span class="checkbox-visual" aria-hidden="true"></span>
                                            <span><%= c.name %></span>
                                        </label>
                                    <% }) %>
                                </div>
                                <div class="modal-actions">
                                    <button type="button" onclick="this.closest('dialog').close()" class="ghost-link">Cancelar</button>
                                    <button type="submit">Salvar</button>
                                </div>
                            </form>
                        </dialog>
                    <% }) %>
                </div>
            </section>

            <section class="tab-panel panel admin-module" data-tab-panel="semestre" id="semestre" hidden>
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Fechamento</p>
                        <h2>Fechar semestre</h2>
                        <p class="panel-copy">O fechamento agora é feito pelo atalho <strong>“Fechar semestre”</strong> nas Ações rápidas, disponível somente enquanto houver ao menos uma audição ativa.</p>
                    </div>
                </div>

                <% if (activeSessions.length > 0) { %>
                    <div class="selection-list semester-list">
                        <% activeSessions.forEach(session => { %>
                            <div class="selection-option" style="cursor:default;">
                                <span class="status-dot online"></span>
                                <div class="selection-copy">
                                    <strong><%= session.turma_name %></strong>
                                    <span>PIN <%= session.code %> ativo</span>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                    <p class="panel-copy">Clicar em “Fechar semestre” nas Ações rápidas vai arquivar essas turmas e reiniciar chamadas e percentuais.</p>
                <% } else { %>
                    <div class="empty-state">
                        <p>Nenhuma audição ativa no momento.</p>
                        <p>Gere um PIN em <a href="#audicao">Audição</a> para liberar o fechamento de semestre.</p>
                    </div>
                <% } %>
            </section>

            <section class="tab-panel panel admin-module history-module" data-tab-panel="historico" id="historico" hidden>
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Arquivo</p>
                        <h2>Histórico oficial de avaliações</h2>
                        <p class="panel-copy">Avaliações fechadas ficam congeladas aqui, mesmo que notas, presenças ou professores mudem depois.</p>
                    </div>
                    <a href="/results/history" class="ghost-link">Ver histórico</a>
                </div>
            </section>
        </main>
    </div>

    <% if (totalActiveSessions > 0) { %>
    <dialog id="closeSemesterModal" class="admin-modal">
        <form method="POST" action="/admin/close-semester" id="closeSemesterForm">
            <% activeSessions.forEach(session => { %>
                <input type="hidden" name="turmaIds" value="<%= session.turma_id %>">
            <% }) %>
            <% if (typeof csrfToken !== 'undefined') { %>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% } %>

            <div class="modal-header danger">
                <h3>Fechar semestre</h3>
                <button type="button" class="modal-close" data-close-modal aria-label="Fechar">×</button>
            </div>

            <div class="modal-body">
                <p class="modal-lead">Esta ação é <strong>irreversível</strong> para o ciclo atual. Confira o que será feito:</p>

                <ul class="modal-checklist">
                    <li>Arquivar os resultados oficiais no <strong>histórico</strong></li>
                    <li>Encerrar as sessões de audição ativas</li>
                    <li>Reiniciar <strong>chamadas e percentuais de presença</strong> das turmas abaixo</li>
                </ul>

                <div class="modal-turmas">
                    <span class="modal-label">Turmas que serão fechadas</span>
                    <ul>
                        <% activeSessions.forEach(session => { %>
                            <li>
                                <strong><%= session.turma_name %></strong>
                                <span>PIN <%= session.code %></span>
                            </li>
                        <% }) %>
                    </ul>
                </div>

                <p class="modal-warning">Só confirme se a audição realmente terminou e as notas já foram consolidadas.</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn-cancel" data-close-modal>Cancelar</button>
                <button type="submit" class="btn-danger-confirm">Confirmar fechamento</button>
            </div>
        </form>
    </dialog>
    <% } %>

    <script src="/transitions.js?v=2"></script>
    <script src="/toast.js?v=2"></script>
    <script>
        document.querySelectorAll('form[method="POST"], form[method="post"]').forEach((form) => {
            if (form.querySelector('input[name="_csrf"]')) return;
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = '_csrf';
            input.value = <%- JSON.stringify(csrfToken) %>;
            form.prepend(input);
        });

        document.addEventListener('DOMContentLoaded', () => {
            const search = document.getElementById('adminSearch');
            const cards = document.querySelectorAll('.searchable-card');
            if (search && cards.length) {
                search.addEventListener('input', () => {
                    const term = search.value.trim().toLowerCase();
                    cards.forEach(card => {
                        const value = card.dataset.search || card.textContent.toLowerCase();
                        card.hidden = term && !value.includes(term);
                    });
                });
            }

            document.querySelectorAll('[data-copy-pin]').forEach(button => {
                button.addEventListener('click', async () => {
                    const pin = button.dataset.copyPin;
                    try {
                        await navigator.clipboard.writeText(pin);
                        if (window.showToast) showToast('PIN copiado.', 'success');
                    } catch (error) {
                        if (window.showToast) showToast('Não foi possível copiar o PIN.', 'error');
                    }
                });
            });
        });

        (function () {
            const modal = document.getElementById('closeSemesterModal');
            if (!modal) return;

            ['btnOpenCloseSemester', 'btnOpenCloseSemesterAudicao'].forEach(id => {
                const btn = document.getElementById(id);
                if (btn) {
                    btn.addEventListener('click', () => {
                        if (typeof modal.showModal === 'function') {
                            modal.showModal();
                        } else {
                            modal.setAttribute('open', '');
                        }
                    });
                }
            });

            modal.querySelectorAll('[data-close-modal]').forEach(btn => {
                btn.addEventListener('click', () => {
                    if (typeof modal.close === 'function') modal.close();
                    else modal.removeAttribute('open');
                });
            });

            // Fecha ao clicar no backdrop
            modal.addEventListener('click', (e) => {
                if (e.target === modal) {
                    if (typeof modal.close === 'function') modal.close();
                    else modal.removeAttribute('open');
                }
            });
        })();

        (function () {
            const links = document.querySelectorAll('.sidebar-nav a[data-tab]');
            const panels = document.querySelectorAll('[data-tab-panel]');
            const STORAGE_KEY = 'adminActiveTab';

            function activateTab(tabId, persist) {
                if (!tabId) tabId = 'dashboard';

                // Se a aba não existir, cai no dashboard
                const exists = document.querySelector('[data-tab-panel="' + tabId + '"]');
                if (!exists) tabId = 'dashboard';

                links.forEach(link => {
                    link.classList.toggle('is-active', link.dataset.tab === tabId);
                });

                panels.forEach(panel => {
                    const active = panel.dataset.tabPanel === tabId;
                    panel.classList.toggle('is-active', active);
                    if (active) panel.removeAttribute('hidden');
                    else panel.setAttribute('hidden', '');
                });

                const titleEl = document.querySelector('.admin-topbar h1');
                const titles = {
                    dashboard: 'Painel Geral',
                    audicao: 'Audição',
                    alunos: 'Alunos',
                    professores: 'Professores',
                    turmas: 'Turmas',
                    semestre: 'Semestre',
                    historico: 'Histórico'
                };
                if (titleEl && titles[tabId]) {
                    titleEl.textContent = titles[tabId];
                }

                if (persist !== false) {
                    try { sessionStorage.setItem(STORAGE_KEY, tabId); } catch (e) {}
                    if (location.hash.replace('#', '') !== tabId) {
                        history.replaceState(null, '', '#' + tabId);
                    }
                }
            }

            links.forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    activateTab(this.dataset.tab);
                });
            });

            // Intercepta qualquer clique em links com hash para abas (ex: Ações rápidas, KPIs, empty-states)
            document.addEventListener('click', (e) => {
                const anchor = e.target.closest('a[href^="#"]');
                if (anchor && !anchor.closest('.sidebar-nav')) {
                    const hash = anchor.getAttribute('href').replace('#', '');
                    if (['dashboard', 'audicao', 'alunos', 'professores', 'turmas', 'semestre', 'historico'].includes(hash)) {
                        activateTab(hash);
                    }
                }
            });

            // Ordem de prioridade: hash da URL > sessionStorage > dashboard
            const fromHash = (window.location.hash || '').replace('#', '');
            let fromStorage = '';
            try { fromStorage = sessionStorage.getItem(STORAGE_KEY) || ''; } catch (e) {}

            const initial = fromHash || fromStorage || 'dashboard';
            activateTab(initial, false);
            // Persiste o que realmente abriu
            try { sessionStorage.setItem(STORAGE_KEY, initial); } catch (e) {}

            window.addEventListener('hashchange', () => {
                activateTab((window.location.hash || '#dashboard').replace('#', ''));
            });

            // Antes de enviar qualquer form do admin, grava a aba atual
            document.querySelectorAll('form').forEach(form => {
                form.addEventListener('submit', function () {
                    const active = document.querySelector('.sidebar-nav a.is-active');
                    const tabId = active ? active.dataset.tab : 'dashboard';
                    try { sessionStorage.setItem(STORAGE_KEY, tabId); } catch (e) {}
                });
            });
        })();
    </script>
    <script src="/theme.js"></script>
    <script src="/back.js"></script>
</body>
</html>
