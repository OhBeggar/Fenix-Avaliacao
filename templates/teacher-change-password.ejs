<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Defina sua nova senha | Fênix</title>
    <script>
    (function () {
      try {
        var theme = localStorage.getItem('fenix-theme');
        if (!theme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) theme = 'dark';
        if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (error) {}
    })();
    </script>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/home.css">
    <link rel="icon" href="/images/fenix-new.png" type="image/png">
</head>
<body>
    <main class="container">
        <div class="header-logo">
            <img src="/images/fenix.svg" alt="Logo Fênix" class="logo">
        </div>
        <div class="eyebrow">Acesso de professores</div>
        <h1>Defina sua nova senha</h1>
        <p class="intro">Por segurança, no primeiro acesso é preciso trocar a senha padrão.</p>

        <% if (typeof message !== 'undefined' && message) { %>
            <div id="toast-data" data-message="<%= message %>" data-type="error" style="display:none"></div>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const data = document.getElementById('toast-data');
                    if (window.showToast && data) showToast(data.dataset.message, data.dataset.type);
                });
            </script>
        <% } %>

        <form class="card" method="POST" action="/avaliacao/alterar-senha">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label>
                Nova senha
                <input type="password" name="password" required minlength="6" maxlength="128" autocomplete="new-password" autofocus>
            </label>
            <label>
                Confirmar senha
                <input type="password" name="password2" required minlength="6" maxlength="128" autocomplete="new-password">
            </label>
            <button type="submit">Salvar e continuar</button>
        </form>

        <form method="POST" action="/teacher/logout" class="actions">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="action-link">Sair</button>
        </form>
    </main>
    <script src="/toast.js"></script>
    <script src="/theme.js"></script>
</body>
</html>
