<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sala da Turma | <%= turma.name %></title>
    <script>
    (function () {
      try {
        var t = localStorage.getItem('fenix-theme');
        if (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          t = 'dark';
        }
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
    </script>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/home.css">
    <link rel="stylesheet" href="/turmas.css">
    <link rel="stylesheet" href="/adm.css">
    <link rel="icon" href="/images/icons8-fenix-cute-color-70.png" type="image/png">
</head>
<body class="admin-body">
    <main class="admin-shell">
        <header class="admin-header">
            <div style="display:flex; gap:16px; align-items:center;">
                <img src="/images/icons8-fenix-cute-color-70.png" alt="Icon" style="height: 40px; width: auto;">
                <div>
                    <span class="eyebrow">Sala da Turma</span>
                    <h1><%= turma.name %></h1>
                    <p style="color: var(--muted); margin: 8px 0 0;">
                        Professor: <%= evaluatorName %> | Responsável: <%= turma.teacher_name || 'Não definido' %>
                    </p>
                </div>
            </div>
            <div style="display:flex; align-items:center; gap:12px;">
                <a href="/turmas/<%= encodeURIComponent(evaluatorName) %>" class="ghost-link nav-action back">Voltar</a>
                <form action="/teacher/logout" method="POST" style="margin:0;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="ghost-link" style="padding:8px 16px;">Sair</button>
                </form>
            </div>
        </header>

        <!-- Banner SSE: mostra quando uma sessão de avaliação estiver disponível (não entra automaticamente) -->
        <div id="sse-banner" style="display:none; background: var(--warning-light, #fef3c7); border: 1px solid var(--warning, #d97706); color: var(--ink); padding: 12px; margin: 12px 0; border-radius:8px;">
            <strong style="color: var(--ink);">Avaliação disponível</strong>
            <small style="display:block; margin-top:6px; color:var(--muted);">Volte à seleção de turmas e informe o PIN compartilhado pelo admin.</small>
        </div>

        <% if (message) { %>
            <div class="message error"><%= message %></div>
        <% } %>

        <details class="panel admin-accordion" open>
            <summary class="accordion-summary">
                <div>
                    <h2>Presença da Turma</h2>
                    <p class="panel-copy">Informe o total de aulas do período e quantas aulas cada aluno compareceu. Mínimo de 80% de presença para seguir para a audição.</p>
                </div>
                <span class="accordion-indicator">Expandir</span>
            </summary>
            <div class="accordion-content">

            <% if (canManageAttendance) { %>
                <form action="/turmas/<%= encodeURIComponent(evaluatorName) %>/<%= turma.id %>/aulas" method="POST" style="margin-top:16px;">
                    <label style="max-width:220px; display:block; margin-bottom:16px;">
                        Total de aulas no período
                        <input type="text" inputmode="numeric" maxlength="4" name="total_aulas" value="<%= turma.total_aulas || 0 %>">
                    </label>

                    <div class="attendance-table-wrap">
                        <table class="attendance-table">
                            <thead>
                                <tr>
                                    <th>Aluno</th>
                                    <th>Aulas presentes</th>
                                    <th>Percentual</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% candidates.forEach(c => {
                                    const summary = attendanceSummary[c.id];
                                    const percentage = summary && typeof summary.percentage === 'number' ? summary.percentage : null;
                                    const statusClass = percentage === null ? 'pending' : (percentage >= 80 ? 'present' : 'absent');
                                %>
                                    <tr>
                                        <td><strong><%= c.name %></strong></td>
                                        <td>
                                            <input type="text" inputmode="numeric" maxlength="4" name="aulas_<%= c.id %>" value="<%= c.aulas_presentes || 0 %>">
                                        </td>
                                        <td><span class="status-chip <%= statusClass %>"><%= summary ? summary.label : '0%' %></span></td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <button type="submit" style="margin-top:16px;">Salvar presença</button>
                </form>
            <% } else { %>
                <div class="presence-grid">
                    <% candidates.forEach(c => { const summary = attendanceSummary[c.id]; %>
                        <article class="presence-card">
                            <div>
                                <strong><%= c.name %></strong>
                                <span><%= c.status %></span>
                            </div>
                            <div class="presence-score <%= summary && summary.percentage >= 80 ? 'ok' : 'risk' %>">
                                <%= summary ? summary.label : c.presence %>
                            </div>
                            <small>
                                <% if (summary && summary.source === 'attendance') { %>
                                    <%= summary.present %> de <%= summary.total %> aula(s)
                                <% } else { %>
                                    Fallback manual
                                <% } %>
                            </small>
                        </article>
                    <% }) %>
                </div>
            <% } %>
            </div>
        </details>

        <% if (canManageAttendance) { %>
        <details class="panel admin-accordion" style="margin-top: 16px;">
            <summary class="accordion-summary">
                <div>
                    <h2>Ritmos Avaliados</h2>
                    <p class="panel-copy">Defina quais ritmos serão avaliados nesta turma. Ex: 1.Forró - 2.Bolero - 3.Zouk</p>
                </div>
                <span class="accordion-indicator">Expandir</span>
            </summary>
            <div class="accordion-content">
                <form action="/turmas/<%= encodeURIComponent(evaluatorName) %>/<%= turma.id %>/ritmos" method="POST" style="margin-top:16px;">
                    <label style="display:block; margin-bottom:16px;">
                        Ritmos da Audição
                        <input type="text" name="ritmosAvaliados" value="<%= turma.ritmos_avaliados || '' %>" placeholder="Ex: 1.Forró - 2.Bolero - 3.Zouk">
                    </label>
                    <button type="submit" style="margin-top:8px;">Salvar ritmos</button>
                </form>
            </div>
        </details>
        <% } else if (turma.ritmos_avaliados) { %>
        <div class="panel" style="margin-top: 16px;">
            <h2>Ritmos Avaliados</h2>
            <p class="panel-copy" style="margin-top: 4px;">Ritmos avaliados nesta turma:</p>
            <p style="margin-top: 8px; font-size: 1rem; font-weight: 600; color: var(--ink);"><%= turma.ritmos_avaliados %></p>
        </div>
        <% } %>
    </main>


    <script>
        (function(){
            const turmaId = <%= JSON.stringify(turma.id) %>;
            const banner = document.getElementById('sse-banner');

            function showBanner() {
                banner.style.display = 'block';
            }

            function hideBanner() {
                banner.style.display = 'none';
            }

            if (window.EventSource) {
                try {
                    const es = new EventSource('/events');
                    es.onmessage = (e) => {
                        try {
                            const payload = JSON.parse(e.data);
                            if (!payload) return;
                            if (payload.event === 'session_started' && Number(payload.turmaId) === Number(turmaId)) {
                                showBanner();
                            }
                            if (payload.event === 'session_closed' && Number(payload.turmaId) === Number(turmaId)) {
                                hideBanner();
                            }
                            if (payload.event === 'session_ended') {
                                // sessão global encerrada: esconde o banner
                                hideBanner();
                            }
                            if (payload.event === 'connected') {
                                // opcional: could request current state
                            }
                        } catch (err) { console.error('SSE parse', err); }
                    };
                    es.onerror = (err) => {
                        // fallback: keep banner hidden on errors
                        // console.warn('EventSource error', err);
                    };
                } catch (e) {
                    console.error('EventSource not available', e);
                }
            }
        })();
    </script>

    <script src="/transitions.js"></script>
    <script src="/toast.js"></script>
    <script>
        document.querySelectorAll('form[method="POST"], form[method="post"]').forEach((form) => {
            if (form.querySelector('input[name="_csrf"]')) return;
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = '_csrf';
            input.value = <%- JSON.stringify(csrfToken) %>;
            form.prepend(input);
        });
    </script>
    <script src="/theme.js"></script>
    <script src="/back.js"></script>
</body>
</html>
