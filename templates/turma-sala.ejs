<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sala da Turma | <%= turma.name %></title>
    <link rel="stylesheet" href="/home.css">
    <link rel="stylesheet" href="/turmas.css">
    <link rel="stylesheet" href="/adm.css">
    <link rel="icon" href="/images/icons8-fenix-cute-color-70.png" type="image/png">
</head>
<body class="admin-body">
    <main class="admin-shell">
        <header class="admin-header">
            <div style="display:flex; gap:16px; align-items:center;">
                <img src="/images/icons8-fenix-cute-color-70.png" alt="Icon" style="height: 40px; width: auto;">
                <div>
                    <span class="eyebrow">Sala da Turma</span>
                    <h1><%= turma.name %></h1>
                    <p style="color: var(--muted); margin: 8px 0 0;">
                        Professor: <%= evaluatorName %> | Responsável: <%= turma.teacher_name || 'Não definido' %>
                    </p>
                </div>
            </div>
            <a href="/turmas/<%= encodeURIComponent(evaluatorName) %>" class="ghost-link">Voltar</a>
        </header>

        <!-- Banner SSE: mostra quando uma sessão de avaliação estiver disponível (não entra automaticamente) -->
        <div id="sse-banner" style="display:none; background: #fff8e6; border: 1px solid #ffd966; padding: 12px; margin: 12px 0; border-radius:6px;">
            <strong>Avaliação disponível</strong>
            <span id="sse-code" style="font-weight:600; margin-left:8px;"></span>
            <button id="sse-join-btn" style="margin-left:16px;">Ir para avaliação</button>
            <small style="display:block; margin-top:6px; color:var(--muted);">Clique no botão para abrir a avaliação manualmente.</small>
        </div>

        <% if (message) { %>
            <div class="message error"><%= message %></div>
        <% } %>

        <details class="panel admin-accordion">
            <summary class="accordion-summary">
                <div>
                    <h2>Presença da Turma</h2>
                    <p class="panel-copy">A presença oficial agora vem das chamadas registradas. O valor antigo só entra como fallback.</p>
                </div>
                <span class="accordion-indicator">Expandir</span>
            </summary>
            <div class="accordion-content">

            <% if (canManageAttendance) { %>
                <form action="/turmas/<%= encodeURIComponent(evaluatorName) %>/<%= turma.id %>/meetings" method="POST" class="candidate-form" style="margin-top:16px;">
                    <label>
                        Nome da chamada
                        <input type="text" name="title" value="Aula" required>
                    </label>
                    <label>
                        Data
                        <input type="date" name="meetingDate" value="<%= new Date().toISOString().slice(0, 10) %>" required>
                    </label>
                    <button type="submit">Criar chamada</button>
                </form>
            <% } %>

            <div class="presence-grid">
                <% candidates.forEach(c => { const summary = attendanceSummary[c.id]; %>
                    <article class="presence-card">
                        <div>
                            <strong><%= c.name %></strong>
                            <span><%= c.status %></span>
                        </div>
                        <div class="presence-score <%= summary && summary.percentage >= 80 ? 'ok' : 'risk' %>">
                            <%= summary ? summary.label : c.presence %>
                        </div>
                        <small>
                            <% if (summary && summary.source === 'attendance') { %>
                                <%= summary.present %> presença(s), <%= summary.absent || 0 %> falta(s)
                            <% } else { %>
                                Fallback manual
                            <% } %>
                        </small>
                    </article>
                <% }) %>
            </div>
            </div>
        </details>

        <details class="panel admin-accordion" open>
            <summary class="accordion-summary">
                <div>
                    <h2>Histórico de Chamadas</h2>
                    <p class="panel-copy"><%= meetings.length %> chamada(s). Alunos sem marcação ficam pendentes e não entram no percentual.</p>
                </div>
                <span class="accordion-indicator">Expandir</span>
            </summary>
            <div class="accordion-content">

            <% if (meetings.length === 0) { %>
                <p class="panel-copy">Nenhuma chamada criada ainda.</p>
            <% } %>

            <% meetings.forEach((meeting, index) => { 
                const attendanceMap = meetingAttendanceMaps[meeting.id] || {};
                const meetingStats = candidates.reduce((acc, c) => {
                    const status = attendanceMap[c.id] || 'pending';
                    acc[status] = (acc[status] || 0) + 1;
                    return acc;
                }, { present: 0, absent: 0, pending: 0 });
            %>
            <details class="attendance-entry">
                <summary>
                    <div>
                        <strong><%= meeting.title %></strong>
                        <span><%= meeting.meeting_date %></span>
                    </div>
                    <div class="attendance-stats">
                        <span class="status-chip present"><%= meetingStats.present %> presente(s)</span>
                        <span class="status-chip absent"><%= meetingStats.absent %> falta(s)</span>
                        <span class="status-chip pending"><%= meetingStats.pending %> pendente(s)</span>
                    </div>
                </summary>

                <% if (canManageAttendance) { %>
                    <form action="/turmas/<%= encodeURIComponent(evaluatorName) %>/<%= turma.id %>/attendance/<%= meeting.id %>" method="POST">
                        <div class="attendance-table-wrap">
                            <table class="attendance-table">
                                <thead>
                                    <tr>
                                        <th>Aluno</th>
                                        <th>Status atual</th>
                                        <th>Presença acumulada</th>
                                        <th>Marcação</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% candidates.forEach(c => {
                                        const saved = attendanceMap[c.id];
                                        const summary = attendanceSummary[c.id];
                                    %>
                                        <tr class="<%= saved ? '' : 'attendance-pending-row' %>">
                                            <td><strong><%= c.name %></strong></td>
                                            <td>
                                                <% if (saved === 'present') { %>
                                                    <span class="status-chip present">Presente</span>
                                                <% } else if (saved === 'absent') { %>
                                                    <span class="status-chip absent">Falta</span>
                                                <% } else { %>
                                                    <span class="status-chip pending">Pendente</span>
                                                <% } %>
                                            </td>
                                            <td><%= summary ? summary.label : c.presence %></td>
                                            <td>
                                                <div class="attendance-options compact">
                                                    <label class="attendance-option present">
                                                        <input type="radio" name="attendance[<%= c.id %>]" value="present" <%= saved === 'present' ? 'checked' : '' %>>
                                                        Presente
                                                    </label>
                                                    <label class="attendance-option absent">
                                                        <input type="radio" name="attendance[<%= c.id %>]" value="absent" <%= saved === 'absent' ? 'checked' : '' %>>
                                                        Falta
                                                    </label>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                        <button type="submit" style="margin-top:16px;">Salvar chamada</button>
                    </form>
                <% } else { %>
                    <p class="panel-copy">Somente o professor responsável pode lançar presença nesta turma.</p>
                <% } %>
            </details>
            <% }) %>
            </div>
        </details>
    </main>

    <script>
        (function(){
            const turmaId = <%= JSON.stringify(turma.id) %>;
            const evaluatorName = <%= JSON.stringify(evaluatorName) %>;
            const banner = document.getElementById('sse-banner');
            const codeEl = document.getElementById('sse-code');
            const joinBtn = document.getElementById('sse-join-btn');

            function showBanner(code) {
                codeEl.textContent = code || '';
                banner.style.display = 'block';
            }

            function hideBanner() {
                banner.style.display = 'none';
            }

            if (window.EventSource) {
                try {
                    const es = new EventSource('/events');
                    es.onmessage = (e) => {
                        try {
                            const payload = JSON.parse(e.data);
                            if (!payload) return;
                            if (payload.event === 'session_started' && Number(payload.turmaId) === Number(turmaId)) {
                                showBanner(payload.code);
                            }
                            if (payload.event === 'session_closed' && Number(payload.turmaId) === Number(turmaId)) {
                                hideBanner();
                            }
                            if (payload.event === 'session_ended') {
                                // sessão global encerrada: esconde o banner
                                hideBanner();
                            }
                            if (payload.event === 'connected') {
                                // opcional: could request current state
                            }
                        } catch (err) { console.error('SSE parse', err); }
                    };
                    es.onerror = (err) => {
                        // fallback: keep banner hidden on errors
                        // console.warn('EventSource error', err);
                    };
                } catch (e) {
                    console.error('EventSource not available', e);
                }
            }

            joinBtn.addEventListener('click', async () => {
                const code = codeEl.textContent;
                if (!code) return alert('Código não disponível.');
                try {
                    const res = await fetch('/turmas/evaluate-access', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ evaluatorName, turmaId, code })
                    });
                    const data = await res.json();
                    if (data && data.success) {
                        window.location = data.redirectUrl;
                    } else {
                        alert((data && data.message) || 'Não foi possível acessar a avaliação.');
                    }
                } catch (err) {
                    console.error(err);
                    alert('Erro ao conectar com o servidor.');
                }
            });
        })();
    </script>

    <script>
        document.querySelectorAll('.attendance-entry').forEach((entry) => {
            entry.addEventListener('toggle', () => {
                if (!entry.open) return;
                document.querySelectorAll('.attendance-entry[open]').forEach((openEntry) => {
                    if (openEntry !== entry) {
                        openEntry.open = false;
                    }
                });
            });
        });
    </script>
    <script src="/transitions.js"></script>
    <script src="/toast.js"></script>
</body>
</html>
