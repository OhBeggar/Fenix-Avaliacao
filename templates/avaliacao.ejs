<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content">
    <title>Avaliação | <%= evaluatorName %>
    </title>
    <script>
    (function () {
      try {
        var t = localStorage.getItem('fenix-theme');
        if (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          t = 'dark';
        }
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
    </script>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/avaliacao.css?v=7">
    <link rel="icon" href="/images/icons8-fenix-cute-color-70.png" type="image/png">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>

<body>
    <main class="page-shell">
        <header class="page-header">
            <div class="header-brand">
                <img src="/images/icons8-fenix-cute-color-70.png" alt="Icon">
                <div>
                    <span class="eyebrow">Professor avaliador</span>
                    <h1>
                        <%= evaluatorName %>
                    </h1>
                </div>
            </div>
            <div class="header-actions">
                <a href="/turmas/<%= encodeURIComponent(evaluatorName) %>" class="ghost-link nav-action back" onclick="return confirm('Deseja voltar para a seleção de turmas?')">Voltar à turma</a>
                <form action="/teacher/logout" method="POST" style="margin:0;" onsubmit="return confirm('Deseja realmente sair do sistema?')">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="ghost-link" style="padding:8px 16px;">Sair</button>
                </form>
            </div>
        </header>

        <section class="page-note">
            <div>
                <p style="display:inline-flex; align-items:center; gap:8px; flex-wrap:wrap;">
                    Notas válidas: inteiros de 1 a 10 ou <strong>X</strong> para item não avaliado.
                    <button type="button" class="help-tip" id="rulesHelpBtn" aria-label="Ver regras de aprovação" title="Regras de aprovação">?</button>
                </p>
                <% if (turma && turma.ritmos_avaliados) { %>
                    <p class="subtle-note"><strong>Ritmos avaliados:</strong> <code><%= turma.ritmos_avaliados %></code>
                    </p>
                    <% } %>
                        <p class="subtle-note">
                            O sistema considera como online quem teve atividade nos últimos
                            <strong>
                                <%= activeEvaluatorStatus.timeoutMinutes %> minutos
                            </strong>.
                        </p>
            </div>
            <div class="online-status">
                <span class="status-pill" id="online-count">
                    <%= activeEvaluatorStatus.activeCount %> avaliador(es) online
                </span>
            </div>
        </section>

        <form id="evaluation-form" method="POST" action="/evaluate/<%= encodeURIComponent(evaluatorName) %>?turmaId=<%= turmaId %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="peso-legend">
                <span class="leg-peso1">Peso 1 — 10%: auxílios · comprometimento</span>
                <span class="leg-peso2">Peso 2 — 30%: desloc./floreio · abraço · equilíbrio</span>
                <span class="leg-peso3">Peso 3 — 60%: passos · ritmo · corpo · condução · musicalidade</span>
                <span class="leg-presenca">Presença nas aulas: mínimo de 80%</span>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Nº</th>
                            <th>Candidato</th>
                            <th>
                                <span class="th-full">Presença nas aulas</span>
                                <span class="th-short">Presença</span>
                            </th>
                            <th class="peso1">
                                <span class="th-full">Presença e comportamento nos auxílios</span>
                                <span class="th-short">Pres. Auxílios</span>
                            </th>
                            <th class="peso1">
                                <span class="th-full">Comprometimento e participação em eventos</span>
                                <span class="th-short">Comprom.</span>
                            </th>
                            <th class="peso2">
                                <span class="th-full">Deslocamento Cavalheiro / Floreio Dama</span>
                                <span class="th-short">Desloc./Floreio</span>
                            </th>
                            <th class="peso2">
                                <span class="th-full">Abraço e Postura</span>
                                <span class="th-short">Abraço e Post.</span>
                            </th>
                            <th class="peso2">
                                <span class="th-full">Equilíbrio</span>
                                <span class="th-short">Equilíbr.</span>
                            </th>
                            <th class="peso3">
                                <span class="th-full">Passos</span>
                                <span class="th-short">Passos</span>
                            </th>
                            <th class="peso3">
                                <span class="th-full">Ritmo</span>
                                <span class="th-short">Ritmo</span>
                            </th>
                            <th class="peso3">
                                <span class="th-full">Corpo do Ritmo</span>
                                <span class="th-short">C. Ritmo</span>
                            </th>
                            <th class="peso3">
                                <span class="th-full">Condução</span>
                                <span class="th-short">Condução</span>
                            </th>
                            <th class="peso3">
                                <span class="th-full">Musicalidade</span>
                                <span class="th-short">Musical.</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <% candidates.forEach((cand, i)=> { %>
                            <tr>
                                <td>
                                    <%= i + 1 %>
                                </td>
                                <td class="candidate-name">
                                    <%= cand.name %>
                                </td>
                                <td>
                                    <%= cand.presence %>
                                </td>
                                <td>
                                    <input type="text" inputmode="numeric" maxlength="2"
                                        name="<%= cand.id %>_presenca_auxilios"
                                        value="<%= (currentScores[cand.id] && currentScores[cand.id].presenca_auxilios) || '' %>">
                                </td>
                                <td>
                                    <input type="text" inputmode="numeric" maxlength="2"
                                        name="<%= cand.id %>_comprometimento_eventos"
                                        value="<%= (currentScores[cand.id] && currentScores[cand.id].comprometimento_eventos) || '' %>">
                                </td>
                                <td>
                                    <% if (cand.gender==='male' ) { %>
                                        <input type="text" inputmode="numeric" maxlength="2"
                                            name="<%= cand.id %>_deslocamento_cavalheiro"
                                            value="<%= (currentScores[cand.id] && currentScores[cand.id].deslocamento_cavalheiro) || '' %>">
                                        <% } else { %>
                                            <input type="text" inputmode="numeric" maxlength="2"
                                                name="<%= cand.id %>_floreio_dama"
                                                value="<%= (currentScores[cand.id] && currentScores[cand.id].floreio_dama) || '' %>">
                                            <% } %>
                                </td>
                                <% commonCriteria.slice(2).forEach((crit)=> { %>
                                    <td>
                                        <input type="text" inputmode="numeric" maxlength="2"
                                            name="<%= cand.id %>_<%= crit %>"
                                            value="<%= (currentScores[cand.id] && currentScores[cand.id][crit]) || '' %>">
                                    </td>
                                    <% }) %>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>

            <div class="toolbar">
                <button type="submit">Salvar notas</button>
            </div>
        </form>

        <div class="rules-popover" id="rulesPopover" hidden>
            <div class="rules-popover-header">
                <strong>Regras de aprovação</strong>
                <button type="button" class="rules-popover-close" id="rulesHelpClose" aria-label="Fechar">×</button>
            </div>
            <ul>
                <li><strong>Presença mínima:</strong> abaixo de 80% → reprovação automática (independente das notas).</li>
                <li><strong>Nota final:</strong> Peso 1 = auxílios + comprometimento; Peso 2 = deslocamento/floreio + abraço + equilíbrio; Peso 3 = critérios técnicos.</li>
                <li><strong>Corte:</strong> nota final ≥ 7,0.</li>
                <li><strong>Maioria simples:</strong> mais da metade dos avaliadores precisa aprovar. Empate reprova.</li>
                <li><strong>Aprovado</strong> só se cumprir nota ≥ 7,0 <em>e</em> maioria.</li>
                <li><strong>Patente:</strong> aprovado sobe de patente no fechamento (ex.: Bolsista → Auxiliar).</li>
            </ul>
        </div>
    </main>
    <script src="/transitions.js"></script>
    <script src="/toast.js"></script>
    <script id="evaluator-config" type="application/json">
        {
            "evaluatorName": <%- JSON.stringify(evaluatorName) %>,
            "turmaId": <%- JSON.stringify(turmaId) %>
        }
    </script>
    <script>
        (function () {
            const onlineCountElement = document.getElementById('online-count');
            const configData = JSON.parse(document.getElementById('evaluator-config').textContent);
            const evaluatorName = configData.evaluatorName;
            const turmaId = configData.turmaId;

            // --- Status online ---
            async function refreshOnlineEvaluators() {
                try {
                    const params = new URLSearchParams({ evaluatorName, turmaId });
                    const response = await fetch(`/api/evaluators/status?${params.toString()}`, { cache: 'no-store' });
                    if (!response.ok) return;

                    const payload = await response.json();
                    if (payload.sessionClosed) {
                        onlineCountElement.textContent = 'Sessão encerrada';
                        onlineCountElement.title = 'O admin encerrou esta avaliação.';
                        return;
                    }

                    onlineCountElement.textContent = `${payload.activeCount} avaliador(es) online`;
                    onlineCountElement.title = payload.activeNames.length
                        ? `Online agora: ${payload.activeNames.join(', ')}`
                        : 'Nenhum avaliador online no momento';
                } catch { }
            }

            refreshOnlineEvaluators();
            setInterval(refreshOnlineEvaluators, 20000);

            // --- Feedback visual ---
            function flashSavedRows() {
                const rows = document.querySelectorAll('tbody tr');
                rows.forEach(row => row.classList.add('just-saved'));
                setTimeout(() => {
                    rows.forEach(row => row.classList.remove('just-saved'));
                }, 1800);
            }

            // Compatibilidade: se ainda vier ?saved=1 (submit antigo)
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('saved') === '1') {
                if (window.showToast) showToast('Notas salvas com sucesso!', 'success');
                flashSavedRows();
                const cleanUrl = window.location.protocol + '//' + window.location.host + window.location.pathname +
                    (urlParams.get('turmaId') ? '?turmaId=' + urlParams.get('turmaId') : '');
                window.history.replaceState({ path: cleanUrl }, '', cleanUrl);
            }

            // --- Salvar sem recarregar a página ---
            const form = document.getElementById('evaluation-form') || document.querySelector('#evaluation-form') || document.querySelector('form');
            const saveBtn = form ? form.querySelector('.toolbar button[type="submit"]') : null;

            if (form && saveBtn) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const originalText = saveBtn.textContent;
                    saveBtn.disabled = true;
                    saveBtn.textContent = 'Salvando...';

                    try {
                        const formData = new FormData(form);
                        const bodyData = new URLSearchParams(formData);
                        const actionUrl = form.getAttribute('action') || form.action || window.location.href;

                        const response = await fetch(actionUrl, {
                            method: 'POST',
                            body: bodyData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest',
                                'Content-Type': 'application/x-www-form-urlencoded'
                            },
                            credentials: 'same-origin'
                        });

                        const data = await response.json().catch(() => ({}));

                        if (!response.ok || data.ok === false) {
                            throw new Error(data.message || 'Erro ao salvar');
                        }

                        if (window.showToast) {
                            showToast(data.message || 'Notas salvas com sucesso!', 'success');
                        }
                        flashSavedRows();

                    } catch (err) {
                        console.error(err);
                        if (window.showToast) {
                            showToast(err.message || 'Erro ao salvar. Tente novamente.', 'error');
                        } else {
                            alert(err.message || 'Erro ao salvar. Tente novamente.');
                        }
                    } finally {
                        saveBtn.disabled = false;
                        saveBtn.textContent = originalText;
                    }
                });
            }

            // Feedback leve ao alterar uma célula (funciona em input e change no mobile)
            document.querySelectorAll('td input[type="text"]').forEach(input => {
                const triggerFlash = function () {
                    this.classList.remove('cell-saved');
                    void this.offsetWidth; // Força reflow para reiniciar a animação no mobile
                    this.classList.add('cell-saved');
                    setTimeout(() => this.classList.remove('cell-saved'), 1200);
                };
                input.addEventListener('change', triggerFlash);
                input.addEventListener('input', triggerFlash);
            });

            // Indicação de scroll horizontal
            const wrap = document.querySelector('.table-wrap');
            if (wrap) {
                function updateScrollHints() {
                    const max = wrap.scrollWidth - wrap.clientWidth;
                    wrap.classList.toggle('has-overflow', max > 8);
                    wrap.classList.toggle('scrolled-start', wrap.scrollLeft > 8);
                    wrap.classList.toggle('scrolled-end', wrap.scrollLeft >= max - 8);
                }
                wrap.addEventListener('scroll', updateScrollHints, { passive: true });
                window.addEventListener('resize', updateScrollHints);
                updateScrollHints();
            }
        })();
    </script>
    <script>
    (function () {
        const helpBtns = document.querySelectorAll('.help-tip');
        const pop = document.getElementById('rulesPopover');
        const closeBtn = document.getElementById('rulesHelpClose');
        if (!pop || !helpBtns.length) return;

        let lastActiveBtn = null;

        function placePopover(btn) {
            if (!btn) btn = lastActiveBtn || helpBtns[0];
            if (!btn) return;
            const rect = btn.getBoundingClientRect();
            const gap = 8;
            let top = rect.bottom + gap;
            let left = rect.left + rect.width / 2 - pop.offsetWidth / 2;

            // Mantém dentro da viewport
            left = Math.max(12, Math.min(left, window.innerWidth - pop.offsetWidth - 12));
            if (top + pop.offsetHeight > window.innerHeight - 12) {
                top = Math.max(12, rect.top - pop.offsetHeight - gap);
            }
            pop.style.top = top + 'px';
            pop.style.left = left + 'px';
        }

        function open(btn) {
            lastActiveBtn = btn;
            pop.hidden = false;
            btn.setAttribute('aria-expanded', 'true');
            placePopover(btn);
        }

        function close() {
            pop.hidden = true;
            helpBtns.forEach(b => b.setAttribute('aria-expanded', 'false'));
        }

        helpBtns.forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.stopPropagation();
                if (pop.hidden || lastActiveBtn !== this) {
                    open(this);
                } else {
                    close();
                }
            });
        });

        if (closeBtn) closeBtn.addEventListener('click', close);

        document.addEventListener('click', function (e) {
            if (!pop.hidden && !pop.contains(e.target) && ![...helpBtns].some(b => b.contains(e.target))) {
                close();
            }
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') close();
        });

        window.addEventListener('resize', function () {
            if (!pop.hidden) placePopover();
        });
    })();
    </script>
    <script src="/theme.js"></script>
    <script src="/back.js"></script>
</body>

</html>