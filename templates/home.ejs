<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Avaliação de Bolsistas | Login</title>
    <script>
    (function () {
      try {
        var t = localStorage.getItem('fenix-theme');
        if (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          t = 'dark';
        }
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
    </script>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/home.css">
    <link rel="icon" href="/images/icons8-fenix-cute-color-70.png" type="image/png">
</head>
<body>
    <div class="theme-switch-floating">
        <label class="theme-switch" title="Alternar tema">
          <input class="theme-switch-input" type="checkbox" role="switch" aria-label="Alternar tema claro e escuro">
          <div class="slider round">
            <div class="sun-moon">
              <svg class="moon-dot moon-dot-1" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="moon-dot moon-dot-2" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="moon-dot moon-dot-3" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="light-ray light-ray-1" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="light-ray light-ray-2" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="light-ray light-ray-3" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="cloud-dark cloud-1" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="cloud-dark cloud-2" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="cloud-dark cloud-3" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="cloud-light cloud-4" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="cloud-light cloud-5" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
              <svg class="cloud-light cloud-6" viewBox="0 0 100 100"><circle cx="50" cy="50" r="50"></circle></svg>
            </div>
            <div class="stars">
              <svg class="star star-1" viewBox="0 0 20 20">
                <path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"></path>
              </svg>
              <svg class="star star-2" viewBox="0 0 20 20">
                <path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"></path>
              </svg>
              <svg class="star star-3" viewBox="0 0 20 20">
                <path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"></path>
              </svg>
              <svg class="star star-4" viewBox="0 0 20 20">
                <path d="M 0 10 C 10 10,10 10 ,0 10 C 10 10 , 10 10 , 10 20 C 10 10 , 10 10 , 20 10 C 10 10 , 10 10 , 10 0 C 10 10,10 10 ,0 10 Z"></path>
              </svg>
            </div>
          </div>
        </label>
    </div>

    <div class="container">
        <div class="header-logo">
            <img src="/images/fenix.png" alt="Logo Fênix" class="logo">
        </div>
        <div class="eyebrow">Audição de Bolsistas</div>
        <h1>Sistema de Avaliação</h1>
        <p class="intro">
            Informe seus dados de acesso para entrar na sala de avaliação.
        </p>

        <% if (typeof message !== 'undefined' && message) { %>
            <div id="toast-data" data-message="<%= message %>" data-type="error" style="display:none"></div>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const dataEl = document.getElementById('toast-data');
                    if (window.showToast && dataEl) {
                        showToast(dataEl.dataset.message, dataEl.dataset.type);
                    }
                });
            </script>
        <% } %>

        <form class="card" id="loginForm" onsubmit="return false;">
            <label>
                Nome do Professor
                <div class="input-wrapper">
                    <input 
                        type="text" 
                        id="nameInput"
                        name="name" 
                        placeholder="Ex: Eduarda Cavalcante" 
                        required 
                        autofocus
                        autocomplete="off"
                    >
                    <span class="status-dot" id="statusDot"></span>
                    <span class="input-loader" id="inputLoader"></span>
                </div>
                <span class="feedback-msg" id="nameFeedback"></span>
            </label>

            <label class="password-group" id="passwordGroup">
                Senha de Acesso
                <div class="input-wrapper password-wrapper">
                    <input
                        type="password"
                        id="passwordInput"
                        name="password"
                        placeholder="Sua senha"
                        required
                        disabled
                        autocomplete="current-password"
                    >
                    <button
                        type="button"
                        class="toggle-password"
                        data-target="passwordInput"
                        aria-label="Mostrar senha"
                        title="Mostrar senha"
                    >👁</button>
                </div>
            </label>

            <button type="button" id="loginBtn" disabled>Entrar na Avaliação</button>
        </form>

        <div class="actions">
            <!-- <a href="/admin/login" class="action-link">Painel ao vivo</a> -->
            <a href="/admin" class="action-link admin">Acessar painel administrativo</a>
        </div>
        <a href="https://www.instagram.com/ohbeggar_" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="infra-badge">
            Powered by @Ohbeggar
        </a>
    </div>

    <script>
        document.addEventListener("mousemove", (e) => {
        document.body.style.setProperty("--mouse-x", `${e.clientX}px`);
        document.body.style.setProperty("--mouse-y", `${e.clientY}px`);
        });
    </script>

    <!-- Footer -->
    <footer class="site-footer">
        <p class="infra-note">Protegido e publicado com Cloudflare Tunnel</p>
        <p>&copy; 2026 Sistema de Avaliação. Todos os direitos reservados.</p>
    </footer>

    <script src="/transitions.js?v=2"></script>
    <script src="/toast.js?v=2"></script>

    <script>
    (function() {
        const nameInput = document.getElementById('nameInput');
        const passwordInput = document.getElementById('passwordInput');
        const passwordGroup = document.getElementById('passwordGroup');
        const statusDot = document.getElementById('statusDot');
        const inputLoader = document.getElementById('inputLoader');
        const nameFeedback = document.getElementById('nameFeedback');
        const loginBtn = document.getElementById('loginBtn');
        const loginForm = document.getElementById('loginForm');

        let debounceTimer;
        let lastCheckedName = '';

        function setStatus(type, msg) {
            statusDot.className = 'status-dot';
            nameFeedback.className = 'feedback-msg';
            nameFeedback.textContent = '';

            if (type === 'loading') {
                inputLoader.classList.add('show');
                return;
            }

            inputLoader.classList.remove('show');

            if (type === 'success') {
                statusDot.classList.add('green', 'show');
                nameFeedback.classList.add('success');
                nameFeedback.textContent = msg || 'Continue com sua senha';
            } else if (type === 'error') {
                statusDot.classList.add('red', 'show');
                nameFeedback.classList.add('error');
                nameFeedback.textContent = msg || 'Professor não cadastrado';
            }
        }

        function clearStatus() {
            statusDot.className = 'status-dot';
            nameFeedback.className = 'feedback-msg';
            nameFeedback.textContent = '';
            inputLoader.classList.remove('show');
        }

        function hidePassword() {
            passwordGroup.classList.remove('visible');
            passwordInput.disabled = true;
            passwordInput.value = '';
            loginBtn.disabled = true;
            if (passwordInput.type === 'text') {
                passwordInput.type = 'password';
                const toggle = passwordGroup.querySelector('.toggle-password');
                if (toggle) {
                    toggle.classList.remove('is-visible');
                    toggle.setAttribute('aria-label', 'Mostrar senha');
                    toggle.title = 'Mostrar senha';
                    toggle.textContent = '👁';
                }
            }
        }

        function showPassword() {
            passwordGroup.classList.add('visible');
            passwordInput.disabled = false;
            loginBtn.disabled = false;
            setTimeout(() => passwordInput.focus(), 350);
        }

        async function checkTeacher(name) {
            if (!name || name.length < 2) {
                clearStatus();
                hidePassword();
                return;
            }

            setStatus('loading');

            try {
                const res = await fetch('/api/check-teacher', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name })
                });
                const data = await res.json();

                if (nameInput.value.trim() !== name) return;

                if (data.exists) {
                    setStatus('success');
                    showPassword();
                } else {
                    setStatus('error', 'Informe o nome completo');
                    hidePassword();
                }
            } catch (err) {
                clearStatus();
                hidePassword();
            }
        }

        nameInput.addEventListener('input', function() {
            const name = this.value.trim();
            clearTimeout(debounceTimer);

            if (name.length === 0) {
                clearStatus();
                hidePassword();
                return;
            }

            if (name.toLowerCase() === lastCheckedName.toLowerCase()) return;

            debounceTimer = setTimeout(() => {
                lastCheckedName = name;
                checkTeacher(name);
            }, 500);
        });

        // Login via fetch (evita abrir nova aba)
        async function doLogin() {
            const name = nameInput.value.trim();
            const password = passwordInput.value;

            if (!name || !password) {
                if (window.showToast) showToast('Preencha nome e senha.', 'error');
                return;
            }

            loginBtn.disabled = true;
            loginBtn.textContent = 'Entrando...';

            try {
                const res = await fetch('/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: new URLSearchParams({ name, password }),
                    redirect: 'manual'
                });

                // Se o servidor redirecionou (302), seguimos manualmente
                const redirectUrl = res.headers.get('Location');
                if (res.status === 0 || res.status === 302 || res.redirected || redirectUrl) {
                    // Tenta pegar o Location header ou faz redirect baseado no nome
                    if (redirectUrl) {
                        window.location.href = redirectUrl;
                    } else {
                        window.location.href = '/turmas/' + encodeURIComponent(name);
                    }
                    return;
                }

                // Se não redirecionou, pode ter dado erro
                const html = await res.text();
                // Verifica se a resposta contém mensagem de erro
                if (html.includes('Professor ou senha inválidos') || res.status === 200) {
                    loginBtn.disabled = false;
                    loginBtn.textContent = 'Entrar na Avaliação';
                    if (window.showToast) showToast('Professor ou senha inválidos.', 'error');
                }
            } catch (err) {
                loginBtn.disabled = false;
                loginBtn.textContent = 'Entrar na Avaliação';
                if (window.showToast) showToast('Erro ao entrar. Tente novamente.', 'error');
            }
        }

        loginBtn.addEventListener('click', doLogin);

        // Enter no campo de senha também dispara login
        passwordInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                doLogin();
            }
        });

        // Enter no campo de nome (se senha já visível)
        nameInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                if (!passwordInput.disabled) {
                    passwordInput.focus();
                }
            }
        });
    })();
    </script>
    <script>
    (function () {
        document.querySelectorAll('.toggle-password').forEach(btn => {
            btn.addEventListener('click', function () {
                const input = document.getElementById(this.dataset.target);
                if (!input) return;

                const showing = input.type === 'text';
                input.type = showing ? 'password' : 'text';
                this.classList.toggle('is-visible', !showing);
                this.setAttribute('aria-label', showing ? 'Mostrar senha' : 'Ocultar senha');
                this.title = showing ? 'Mostrar senha' : 'Ocultar senha';
                this.textContent = showing ? '👁' : '🙈';
            });
        });
    })();
    </script>
    <script src="/theme.js"></script>
</body>
</html>
