<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerenciar <%= turma.name %> | Admin</title>
    <script>
    (function () {
      try {
        var t = localStorage.getItem('fenix-theme');
        if (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          t = 'dark';
        }
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
    </script>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/adm.css">
    <link rel="icon" href="/images/icons8-fenix-cute-color-70.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="admin-body">
    <%
        const totalCandidates = candidates.length;
        const percentages = candidates
            .map(c => attendanceSummary[c.id] && typeof attendanceSummary[c.id].percentage === 'number' ? attendanceSummary[c.id].percentage : null)
            .filter(v => v !== null);
        const averagePresence = percentages.length ? Math.round(percentages.reduce((sum, value) => sum + value, 0) / percentages.length) : 0;
        const riskCount = candidates.filter(c => {
            const summary = attendanceSummary[c.id];
            return summary && typeof summary.percentage === 'number' && summary.percentage < 80;
        }).length;
    %>

    <main class="admin-shell turma-detail-shell">
        <header class="admin-header detail-header">
            <div class="header-brand">
                <img src="/images/icons8-fenix-cute-color-70.png" alt="Fênix Dança">
                <div>
                    <p class="breadcrumb">
                        <% if (isAdmin) { %>
                            <a href="/admin#dashboard">Dashboard</a> /
                            <a href="/admin#turmas">Turmas</a> /
                        <% } else { %>
                            Turmas /
                        <% } %>
                        <%= turma.name %>
                    </p>
                    <h1><%= turma.name %></h1>
                    <p class="panel-copy">Responsável: <%= turma.teacher_name || 'Não definido' %></p>
                </div>
            </div>
            <a href="<%= isAdmin ? '/admin#turmas' : '/turmas' %>" class="ghost-link nav-action back">Voltar</a>
        </header>
            <div class="turma-card-actions" style="margin-top: 20px; display: flex; gap: 8px;">
                <button onclick="document.getElementById('renameModal').showModal()" class="btn-secondary" style="padding: 6px 12px;">Editar nome</button>
            </div>
        </section>

        <dialog id="renameModal">
            <h3>Renomear Turma</h3>
            <p style="color: var(--muted); font-size: 0.9rem;">Altere o nome da turma para atualizar o período no título do PDF.</p>
            
            <form action="/admin/turma/rename" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="turmaId" value="<%= turma.id %>">
                
                <label>Novo nome da turma</label>
                <input type="text" name="newName" value="<%= turma.name %>" style="width: 100%; padding: 8px; margin-top: 8px;" required>
                
                <div class="modal-actions" style="margin-top: 20px; display: flex; gap: 12px; justify-content: flex-end;">
                    <button type="button" class="btn-cancel" onclick="this.closest('dialog').close()">Cancelar</button>
                    <button type="submit" class="btn-primary">Salvar alterações</button>
                </div>
            </form>
        </dialog>

        <% if (typeof message !== 'undefined' && message) { %>
            <div id="toast-data"
                 data-message="<%= message.text %>"
                 data-type="<%= message.type === 'success' ? 'success' : 'error' %>"
                 style="display:none"></div>
            <script>
                document.addEventListener('DOMContentLoaded', () => {
                    const dataEl = document.getElementById('toast-data');
                    if (window.showToast && dataEl) {
                        showToast(dataEl.dataset.message, dataEl.dataset.type);
                    }
                });
            </script>
        <% } %>

        <section class="turma-hero">
            <div>
                <p class="eyebrow">Central da turma</p>
                <h2><%= turma.name %></h2>
                <p>Controle alunos, presença consolidada e ritmos avaliados da turma.</p>
            </div>
            <div class="hero-metrics">
                <article>
                    <strong><%= totalCandidates %></strong>
                    <span>Alunos</span>
                </article>
                <article>
                    <strong><%= averagePresence %>%</strong>
                    <span>Presença média</span>
                </article>
                <article>
                    <strong><%= riskCount %></strong>
                    <span>Em atenção</span>
                </article>
            </div>
        </section>

        <section class="panel admin-module">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Alunos</p>
                    <h2>Alunos da turma</h2>
                    <p class="panel-copy">Use a busca para localizar rapidamente um aluno nesta turma.</p>
                </div>
                <label class="module-search">
                    <span>⌕</span>
                    <input id="studentSearch" type="search" placeholder="Buscar aluno...">
                </label>
            </div>

            <% if (candidates.length === 0) { %>
                <div class="empty-state">
                    <p>Nenhum aluno cadastrado nesta turma ainda.</p>
                    <p>Adicione alunos através do painel principal de administração.</p>
                </div>
            <% } else { %>
                <div class="presence-grid searchable-group">
                    <% candidates.forEach(c => {
                        const summary = attendanceSummary[c.id];
                        const percentage = summary && typeof summary.percentage === 'number' ? summary.percentage : null;
                        const statusClass = percentage === null ? 'pending' : (percentage >= 80 ? 'ok' : 'risk');
                        const statusLabel = percentage === null ? 'Sem dados' : (percentage >= 80 ? 'Em dia' : 'Atenção');
                    %>
                        <article class="presence-card student-card searchable-card" data-search="<%= `${c.name} ${c.gender} ${c.status}`.toLowerCase() %>">
                            <div class="student-card-head">
                                <span class="avatar-chip"><%= c.name.charAt(0).toUpperCase() %></span>
                                <div>
                                    <strong><%= c.name %></strong>
                                    <span><%= c.gender === 'male' ? 'Cavalheiro' : 'Dama' %> · <%= c.status %></span>
                                </div>
                            </div>

                            <div class="presence-score <%= statusClass %>">
                                <span><%= statusLabel %></span>
                                <strong><%= summary ? summary.label : c.presence %></strong>
                            </div>

                            <small>
                                <% if (summary && summary.source === 'attendance') { %>
                                    <%= summary.present %> presença(s), <%= summary.absent || 0 %> falta(s)
                                <% } else { %>
                                    Fallback manual
                                <% } %>
                            </small>

                            <form action="/admin/candidate/status" method="POST" class="mini-form status-form">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="candidateId" value="<%= c.id %>">
                                <input type="hidden" name="turmaId" value="<%= turma.id %>">
                                <label>
                                    Status
                                    <select name="status" onchange="this.form.requestSubmit()">
                                        <option value="Bolsista" <%= c.status === 'Bolsista' ? 'selected' : '' %>>Bolsista</option>
                                        <option value="Auxiliar" <%= c.status === 'Auxiliar' ? 'selected' : '' %>>Auxiliar</option>
                                    </select>
                                </label>
                            </form>

                            <form action="/admin/candidate/delete" method="POST" class="js-confirm-form"
                                  data-confirm-title="Remover aluno"
                                  data-confirm-message="Remover <%= c.name %> desta turma?">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="candidateId" value="<%= c.id %>">
                                <input type="hidden" name="turmaId" value="<%= turma.id %>">
                                <button type="submit" class="danger ghost-danger full-width">Remover aluno</button>
                            </form>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>

        <% if (candidates.length > 0) { %>
            <section class="panel admin-module">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">Presença</p>
                        <h2>Aulas e frequência</h2>
                        <p class="panel-copy">Informe o total de aulas do período e quantas aulas cada aluno compareceu. O sistema calcula o percentual automaticamente (mínimo de 80% para seguir para a audição).</p>
                    </div>
                </div>

                <form action="/admin/turma/<%= turma.id %>/aulas" method="POST">
                    <label style="max-width:220px; display:block; margin-bottom:16px;">
                        Total de aulas no período
                        <input
                            type="text"
                            inputmode="numeric"
                            maxlength="4"
                            name="total_aulas"
                            value="<%= turma.total_aulas || 0 %>"
                        >
                    </label>

                    <div class="admin-table-wrap scores-table">
                        <table>
                            <thead>
                                <tr>
                                    <th>Aluno</th>
                                    <th>Aulas presentes</th>
                                    <th>Percentual</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% candidates.forEach(c => {
                                    const summary = attendanceSummary[c.id];
                                    const percentage = summary && typeof summary.percentage === 'number' ? summary.percentage : null;
                                    const statusClass = percentage === null ? 'pending' : (percentage >= 80 ? 'present' : 'absent');
                                %>
                                    <tr>
                                        <td><strong><%= c.name %></strong></td>
                                        <td>
                                            <input
                                                type="text"
                                                inputmode="numeric"
                                                maxlength="4"
                                                name="aulas_<%= c.id %>"
                                                value="<%= c.aulas_presentes || 0 %>"
                                            >
                                        </td>
                                        <td>
                                            <span class="status-chip <%= statusClass %>"><%= summary ? summary.label : '0%' %></span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <div class="module-footer">
                        <button type="submit">Salvar presença</button>
                    </div>
                </form>
            </section>
        <% } %>

        <section class="panel admin-module">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Configurações</p>
                    <h2>Ritmos Avaliados</h2>
                    <p class="panel-copy">Defina quais ritmos serão avaliados nesta turma. Ex: 1.Forró - 2.Bolero - 3.Zouk</p>
                </div>
            </div>

            <form action="/admin/turma/ritmos" method="POST" class="candidate-form form-card">
                <input type="hidden" name="turmaId" value="<%= turma.id %>">
                <label>
                    Ritmos da Audição
                    <input type="text" name="ritmosAvaliados" value="<%= turma.ritmos_avaliados || '' %>" placeholder="Ex: 1.Forró - 2.Bolero - 3.Zouk">
                </label>
                <div class="module-footer" style="padding-top: 1rem;">
                    <button type="submit">Salvar ritmos</button>
                </div>
            </form>
        </section>
    </main>

    <dialog id="confirmModal" class="admin-modal">
        <form method="dialog" id="confirmModalForm">
            <div class="modal-header danger">
                <h3 id="confirmModalTitle">Confirmar ação</h3>
            </div>
            <p id="confirmModalMessage" class="modal-body-text"></p>
            <div class="modal-actions">
                <button type="button" class="ghost-link" id="confirmModalCancel">Cancelar</button>
                <button type="submit" class="danger" id="confirmModalOk">Confirmar</button>
            </div>
        </form>
    </dialog>

    <script src="/transitions.js"></script>
    <script src="/toast.js"></script>
    <script>
        document.querySelectorAll('form[method="POST"], form[method="post"]').forEach((form) => {
            if (form.querySelector('input[name="_csrf"]')) return;
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = '_csrf';
            input.value = <%- JSON.stringify(csrfToken) %>;
            form.prepend(input);
        });

        document.addEventListener('DOMContentLoaded', () => {
            const search = document.getElementById('studentSearch');
            const cards = document.querySelectorAll('.searchable-card');
            if (search && cards.length) {
                search.addEventListener('input', () => {
                    const term = search.value.trim().toLowerCase();
                    cards.forEach(card => {
                        const value = card.dataset.search || card.textContent.toLowerCase();
                        card.hidden = term && !value.includes(term);
                    });
                });
            }
        });

        (function () {
            const modal = document.getElementById('confirmModal');
            const titleEl = document.getElementById('confirmModalTitle');
            const messageEl = document.getElementById('confirmModalMessage');
            const cancelButton = document.getElementById('confirmModalCancel');
            const modalForm = document.getElementById('confirmModalForm');
            if (!modal || !modalForm) return;

            let pendingForm = null;

            document.querySelectorAll('form.js-confirm-form').forEach((sourceForm) => {
                sourceForm.addEventListener('submit', (event) => {
                    event.preventDefault();
                    pendingForm = sourceForm;
                    titleEl.textContent = sourceForm.dataset.confirmTitle || 'Confirmar ação';
                    messageEl.textContent = sourceForm.dataset.confirmMessage || 'Tem certeza?';
                    if (typeof modal.showModal === 'function') modal.showModal();
                    else modal.setAttribute('open', '');
                });
            });

            function closeModal() {
                pendingForm = null;
                if (typeof modal.close === 'function') modal.close();
                else modal.removeAttribute('open');
            }

            cancelButton.addEventListener('click', closeModal);
            modalForm.addEventListener('submit', (event) => {
                event.preventDefault();
                const sourceForm = pendingForm;
                closeModal();
                if (sourceForm) HTMLFormElement.prototype.submit.call(sourceForm);
            });
            modal.addEventListener('click', (event) => {
                if (event.target === modal) closeModal();
            });
            modal.addEventListener('cancel', () => { pendingForm = null; });
        })();
    </script>
    <script src="/theme.js"></script>
    <script src="/back.js"></script>
</body>
</html>
