<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Selecionar Turma | Avaliação</title>
    <script>
    (function () {
      try {
        var t = localStorage.getItem('fenix-theme');
        if (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          t = 'dark';
        }
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
    </script>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/home.css">
    <link rel="stylesheet" href="/turmas.css">
    <link rel="icon" href="/images/fenix-new.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <% const availableEvaluationTurmas = typeof activeEvaluationTurmas !== 'undefined' ? activeEvaluationTurmas : []; %>
    <div class="turmas-container">
        <header class="turmas-header">
            <div style="display:flex; gap:12px; align-items:center; justify-content:center; margin-bottom: 8px;">
                <img src="/images/fenix-app.png?v=2" alt="Icon" style="height: 40px; width: auto;">
                <div>
                    <span class="eyebrow">Bem-vindo, <%= evaluatorName %></span>
                    <h1>Selecione a Turma</h1>
                </div>
            </div>
            <p class="intro">Acesse a sala da turma para ver os alunos. Use “Entrar na avaliação” com o PIN do admin quando a audição estiver liberada.</p>
        </header>

        <div class="turmas-topbar">
            <form action="/teacher/logout" method="POST" style="margin:0;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="ghost-link" style="padding:8px 16px;">Sair</button>
            </form>
            <button
                type="button"
                id="globalEvaluationButton"
                class="global-evaluation-button <%= availableEvaluationTurmas.length === 0 ? 'is-idle' : '' %>"
                <%= availableEvaluationTurmas.length === 0 ? 'disabled' : '' %>>
                <span><%= availableEvaluationTurmas.length === 0 ? 'Aguardando avaliação' : 'Entrar na avaliação' %></span>
                <% if (availableEvaluationTurmas.length > 0) { %>
                    <strong><%= availableEvaluationTurmas.length %></strong>
                <% } %>
            </button>
        </div>

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="message error" style="margin-bottom:18px;"><%= message %></div>
        <% } %>

        <% if (turmas.length === 0) { %>
            <div class="empty-state">
                <p>Nenhuma turma cadastrada no momento.<br>Contate o administrador.</p>
            </div>
        <% } else { %>
            <div class="turmas-grid">
                <% turmas.forEach(t => { %>
                    <div
                        class="turma-card"
                        role="button"
                        tabindex="0"
                        data-action="room"
                        data-turma-id="<%= t.id %>"
                        data-turma-name="<%= t.name.replace(/"/g, '&quot;') %>">
                        <div>
                            <h3><%= t.name %></h3>
                            <p>Responsável: <%= t.teacher_name || 'Não definido' %></p>
                        </div>
                        <div class="turma-card-footer">
                            <span class="turma-badge <%= t.hasActiveEvaluation ? 'is-active' : '' %>">
                                <%= t.hasActiveEvaluation ? 'Avaliação liberada' : 'Disponível' %>
                            </span>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

    <% if (typeof webauthn !== 'undefined' && webauthn.enabled) { %>
    <!-- Biometria: link discreto no rodapé + janela (aviso único após o login e gerenciamento) -->
    <style>
        .bio-footer { text-align: center; margin: 4px 0 32px; }
        .bio-footer a { color: var(--muted); font-size: .85rem; text-decoration: underline; }
        .bio-device-list { list-style: none; margin: 0 0 16px; padding: 0; display: grid; gap: 8px; text-align: left; }
        .bio-device-list li { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--line); font-size: .9rem; }
        .bio-device-list small { color: var(--muted); display: block; }
        .bio-never { display: block; margin: 14px auto 0; background: none; border: none; box-shadow: none; min-height: auto; padding: 6px 10px; color: var(--muted); font-size: .82rem; font-weight: 500; text-decoration: underline; cursor: pointer; }
        .bio-never:hover { background: none; transform: none; box-shadow: none; color: var(--ink); }
    </style>
    <p class="bio-footer" id="bioFooter" style="display:none"><a href="#" id="bioManageLink">Gerenciar biometria</a></p>
    <div class="modal-backdrop" id="bioModal" aria-hidden="true">
        <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="bioTitle">
            <h3 id="bioTitle">Biometria</h3>
            <p id="bioText"></p>
            <ul class="bio-device-list" id="bioDeviceList"></ul>
            <div class="modal-actions" id="bioActions"></div>
            <button type="button" class="bio-never" id="bioNever" style="display:none">Não perguntar mais neste aparelho</button>
        </div>
    </div>
    <% } %>

    <!-- Modal de PIN da Avaliação -->
    <div class="modal-backdrop" id="evaluationModal">
        <div class="modal-card">
            <h3>Entrar na Avaliação</h3>
            <p id="evaluationModalTurmaName">Selecione a turma liberada pelo admin e informe o PIN.</p>
            <div class="evaluation-turma-list" id="evaluationTurmaList"></div>
            <input type="text" id="evaluationPinInput" class="pin-input" maxlength="4" pattern="\d{4}" inputmode="numeric" placeholder="0000">
            <div class="modal-actions">
                <button class="btn-cancel" id="btnEvaluationCancel">Cancelar</button>
                <button id="btnEvaluationConfirm">Confirmar PIN</button>
            </div>
        </div>
    </div>

    <% if (typeof webauthn !== 'undefined' && webauthn.enabled) { %>
    <script src="/webauthn.js?v=2"></script>
    <script>
        // Biometria: aviso único depois do login com senha + gerenciamento discreto no rodapé.
        document.addEventListener('DOMContentLoaded', function () {
            var api = window.AvaliWebAuthn;
            var modal = document.getElementById('bioModal');
            var footer = document.getElementById('bioFooter');
            if (!api || !modal || !footer) return;

            var rpID = <%- safeJson(webauthn.rpID) %>;
            if (!api.isUsableHere(rpID)) return;

            var cfg = JSON.parse(document.getElementById('turmas-config').textContent || '{}');
            var csrf = cfg.csrfToken;
            var teacherName = cfg.evaluatorName;
            var titleEl = document.getElementById('bioTitle');
            var textEl = document.getElementById('bioText');
            var listEl = document.getElementById('bioDeviceList');
            var actionsEl = document.getElementById('bioActions');
            var neverEl = document.getElementById('bioNever');
            var devices = [];
            var max = 5;

            function toast(message, type) {
                if (window.showToast) showToast(message, type || 'info');
            }

            function formatDate(value) {
                if (!value) return '';
                var date = new Date(String(value).replace(' ', 'T') + 'Z');
                return isNaN(date.getTime()) ? '' : date.toLocaleDateString('pt-BR');
            }

            function openModal() {
                modal.classList.add('active');
                modal.setAttribute('aria-hidden', 'false');
            }

            function closeModal() {
                modal.classList.remove('active');
                modal.setAttribute('aria-hidden', 'true');
            }

            function makeButton(label, className, handler) {
                var button = document.createElement('button');
                button.type = 'button';
                if (className) button.className = className;
                button.textContent = label;
                button.addEventListener('click', handler);
                return button;
            }

            function refresh() {
                return api.listDevices().then(function (data) {
                    max = data.max || max;
                    devices = data.credentials || [];
                    // o servidor não tem mais nenhuma chave: este aparelho volta a usar só a senha
                    if (!devices.length) api.removeName(teacherName);
                });
            }

            function activate(button) {
                button.disabled = true;
                button.textContent = 'Aguardando biometria...';
                api.register(csrf, undefined, teacherName).then(function (list) {
                    devices = list;
                    closeModal();
                    toast('Biometria ativada neste aparelho.', 'success');
                }).catch(function (error) {
                    if (error && error.name === 'InvalidStateError') {
                        // A chave já existe neste aparelho (ex.: sincronizada pela conta Google/Apple).
                        api.addName(teacherName);
                        closeModal();
                        toast('Este aparelho já está com a biometria ativada.', 'success');
                        return refresh();
                    }
                    button.disabled = false;
                    button.textContent = 'Ativar biometria';
                    toast(api.friendlyError(error), 'error');
                });
            }

            function renderDevices() {
                listEl.innerHTML = '';
                devices.forEach(function (device) {
                    var li = document.createElement('li');
                    var info = document.createElement('div');
                    var label = document.createElement('span');
                    label.textContent = device.label;
                    var meta = document.createElement('small');
                    var used = device.lastUsedAt ? 'usado em ' + formatDate(device.lastUsedAt) : 'ainda não usado';
                    meta.textContent = 'cadastrado em ' + formatDate(device.createdAt) + ' · ' + used;
                    info.appendChild(label);
                    info.appendChild(meta);

                    var remove = makeButton('Remover', 'ghost-link', function () {
                        if (!window.confirm('Remover "' + device.label + '"? Esse aparelho volta a precisar da senha.')) return;
                        remove.disabled = true;
                        api.removeDevice(device.id, csrf).then(function (remaining) {
                            devices = remaining;
                            if (!remaining.length) api.removeName(teacherName);
                            toast('Aparelho removido.', 'success');
                            openManage();
                        }).catch(function (error) {
                            remove.disabled = false;
                            toast(api.friendlyError(error), 'error');
                        });
                    });
                    remove.style.padding = '6px 12px';

                    li.appendChild(info);
                    li.appendChild(remove);
                    listEl.appendChild(li);
                });
            }

            // Aviso único, logo depois de entrar com a senha
            function openPrompt() {
                titleEl.textContent = 'Entrar mais rápido?';
                textEl.textContent = 'Da próxima vez, ao digitar seu nome, você entra com a digital ou o rosto, sem digitar a senha.';
                listEl.innerHTML = '';
                actionsEl.innerHTML = '';
                actionsEl.appendChild(makeButton('Agora não', 'btn-cancel', function () {
                    api.snoozeAsk(teacherName);
                    closeModal();
                }));
                var enable = makeButton('Ativar biometria', '', function () { activate(enable); });
                actionsEl.appendChild(enable);
                neverEl.style.display = '';
                neverEl.onclick = function () {
                    api.neverAsk(teacherName);
                    closeModal();
                    toast('Tudo bem. Você pode ativar depois em "Gerenciar biometria".', 'info');
                };
                openModal();
            }

            // Gerenciar aparelhos (link no rodapé)
            function openManage() {
                var active = api.hasName(teacherName);
                titleEl.textContent = 'Biometria';
                textEl.textContent = active
                    ? 'Ativa neste aparelho. Ao digitar seu nome, você entra com a digital ou o rosto.'
                    : 'Ative neste aparelho para entrar sem digitar a senha.';
                renderDevices();
                actionsEl.innerHTML = '';
                neverEl.style.display = 'none';
                actionsEl.appendChild(makeButton('Fechar', 'btn-cancel', closeModal));
                if (!active && devices.length < max) {
                    var enable = makeButton('Ativar neste aparelho', '', function () { activate(enable); });
                    actionsEl.appendChild(enable);
                }
                openModal();
            }

            document.getElementById('bioManageLink').addEventListener('click', function (event) {
                event.preventDefault();
                openManage();
            });
            modal.addEventListener('click', function (event) {
                if (event.target === modal) closeModal();
            });
            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') closeModal();
            });

            // Versão anterior usava um "sinalizador" único; agora o aparelho lembra o nome de cada professor.
            api.clearLegacyFlag();

            refresh().then(function () {
                footer.style.display = '';

                var justLoggedIn = false;
                try {
                    justLoggedIn = sessionStorage.getItem('avaliJustLoggedIn') === '1';
                    sessionStorage.removeItem('avaliJustLoggedIn');
                } catch (e) { /* ignore */ }

                if (justLoggedIn && !api.hasName(teacherName) && api.shouldAsk(teacherName) && devices.length < max) {
                    openPrompt();
                }
            }).catch(function () { /* sem biometria: não mostra nada */ });
        });
    </script>
    <% } %>
    <script id="turmas-config" type="application/json">
        {
            "evaluatorName": <%- safeJson(evaluatorName) %>,
            "activeEvaluationTurmas": <%- safeJson(availableEvaluationTurmas) %>,
            "csrfToken": <%- safeJson(csrfToken) %>
        }
    </script>
    <script>
        (function(){
            const cfg = JSON.parse(document.getElementById('turmas-config').textContent || '{}');
            const evaluatorName = cfg.evaluatorName;
            const activeSet = new Set((cfg.activeEvaluationTurmas || []).map(t => Number(t.id)));

            const globalBtn = document.getElementById('globalEvaluationButton');
            function updateGlobalButton() {
                const count = activeSet.size;
                globalBtn.classList.toggle('is-idle', count === 0);
                globalBtn.disabled = count === 0;
                globalBtn.querySelector('span').textContent = count === 0 ? 'Aguardando avaliação' : 'Entrar na avaliação';
                const strong = globalBtn.querySelector('strong');
                if (count > 0) {
                    if (!strong) {
                        const s = document.createElement('strong');
                        s.textContent = String(count);
                        globalBtn.appendChild(s);
                    } else {
                        strong.textContent = String(count);
                    }
                } else {
                    if (strong) strong.remove();
                }
            }

            function markTurmaActive(turmaId) {
                const card = document.querySelector(`.turma-card[data-turma-id="${turmaId}"]`);
                if (!card) return;
                const badge = card.querySelector('.turma-badge');
                if (badge) {
                    badge.classList.add('is-active');
                    badge.textContent = 'Avaliação liberada';
                }
            }
            function markTurmaIdle(turmaId) {
                const card = document.querySelector(`.turma-card[data-turma-id="${turmaId}"]`);
                if (!card) return;
                const badge = card.querySelector('.turma-badge');
                if (badge) {
                    badge.classList.remove('is-active');
                    badge.textContent = 'Disponível';
                }
            }

            updateGlobalButton();

            if (window.EventSource) {
                try {
                    const es = new EventSource('/events');
                    es.onmessage = (e) => {
                        try {
                            const payload = JSON.parse(e.data);
                            if (!payload) return;
                            if (payload.event === 'session_started' && payload.turmaId) {
                                activeSet.add(Number(payload.turmaId));
                                markTurmaActive(Number(payload.turmaId));
                                updateGlobalButton();
                                // dispatch custom event so other scripts can react
                                window.dispatchEvent(new CustomEvent('sse:session_started', { detail: payload }));
                            }
                            if (payload.event === 'session_closed' && payload.turmaId) {
                                activeSet.delete(Number(payload.turmaId));
                                markTurmaIdle(Number(payload.turmaId));
                                updateGlobalButton();
                                window.dispatchEvent(new CustomEvent('sse:session_closed', { detail: payload }));
                            }
                            if (payload.event === 'session_ended') {
                                // limpa todas as sessões ativas
                                Array.from(activeSet).forEach(tid => {
                                    markTurmaIdle(Number(tid));
                                });
                                activeSet.clear();
                                updateGlobalButton();
                                window.dispatchEvent(new CustomEvent('sse:session_ended'));
                            }
                        } catch (err) { console.error('SSE parse', err); }
                    };
                    es.onerror = (err) => {
                        // console.warn('EventSource error', err);
                    };
                } catch (e) { console.error('EventSource init failed', e); }
            }
        })();
    </script>
    <script>
        // Passa dados do servidor para o JS de forma segura para o linter
        window.TURMAS_CONFIG = JSON.parse(document.getElementById('turmas-config').textContent);
    </script>
    <script src="/transitions.js?v=2"></script>
    <script src="/toast.js?v=2"></script>
    <script src="/turmas.js"></script>

    <!-- Proteção: impede abertura de nova aba por padrão, mas respeita `target="_blank"` -->
    <script>
    (function() {
        document.querySelectorAll('a[href^="/"], form[action^="/"]').forEach(function(el) {
            // Preserve explicit new-tab intents and developer overrides
            const t = el.getAttribute('target');
            if ((t && t.toLowerCase() === '_blank') || el.hasAttribute('data-preserve-target')) {
                return;
            }
            el.removeAttribute('target');
        });
    })();
    </script>
    <script src="/theme.js"></script>
    <script src="/back.js"></script>
</body>
</html>
