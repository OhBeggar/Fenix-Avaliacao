<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Selecionar Turma | Avaliação</title>
    <script>
    (function () {
      try {
        var t = localStorage.getItem('fenix-theme');
        if (!t && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
          t = 'dark';
        }
        if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) {}
    })();
    </script>
    <link rel="stylesheet" href="/theme.css">
    <link rel="stylesheet" href="/home.css">
    <link rel="stylesheet" href="/turmas.css">
    <link rel="icon" href="/images/icons8-fenix-cute-color-70.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <% const availableEvaluationTurmas = typeof activeEvaluationTurmas !== 'undefined' ? activeEvaluationTurmas : []; %>
    <div class="turmas-container">
        <header class="turmas-header">
            <div style="display:flex; gap:12px; align-items:center; justify-content:center; margin-bottom: 8px;">
                <img src="/images/icons8-fenix-cute-color-70.png" alt="Icon" style="height: 40px; width: auto;">
                <div>
                    <span class="eyebrow">Bem-vindo, <%= evaluatorName %></span>
                    <h1>Selecione a Turma</h1>
                </div>
            </div>
            <p class="intro">Entre na avaliação com o PIN do admin ou acesse a sala interna com a senha da turma.</p>
        </header>

        <div class="turmas-topbar">
            <form action="/teacher/logout" method="POST" style="margin:0;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="ghost-link" style="padding:8px 16px;">Sair</button>
            </form>
            <button
                type="button"
                id="globalEvaluationButton"
                class="global-evaluation-button <%= availableEvaluationTurmas.length === 0 ? 'is-idle' : '' %>"
                <%= availableEvaluationTurmas.length === 0 ? 'disabled' : '' %>>
                <span><%= availableEvaluationTurmas.length === 0 ? 'Aguardando avaliação' : 'Entrar na avaliação' %></span>
                <% if (availableEvaluationTurmas.length > 0) { %>
                    <strong><%= availableEvaluationTurmas.length %></strong>
                <% } %>
            </button>
        </div>

        <% if (typeof message !== 'undefined' && message) { %>
            <div class="message error" style="margin-bottom:18px;"><%= message %></div>
        <% } %>

        <% if (turmas.length === 0) { %>
            <div class="empty-state">
                <p>Nenhuma turma cadastrada no momento.<br>Contate o administrador.</p>
            </div>
        <% } else { %>
            <div class="turmas-grid">
                <% turmas.forEach(t => { %>
                    <div
                        class="turma-card"
                        role="button"
                        tabindex="0"
                        data-action="room"
                        data-turma-id="<%= t.id %>"
                        data-turma-name="<%= t.name.replace(/"/g, '&quot;') %>">
                        <div>
                            <h3><%= t.name %></h3>
                            <p>Responsável: <%= t.teacher_name || 'Não definido' %></p>
                        </div>
                        <div class="turma-card-footer">
                            <span class="turma-badge <%= t.hasActiveEvaluation ? 'is-active' : '' %>">
                                <%= t.hasActiveEvaluation ? 'Avaliação liberada' : 'Disponível' %>
                            </span>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

    <!-- Modal de Senha da Turma -->
    <div class="modal-backdrop" id="roomModal">
        <div class="modal-card">
            <h3>Senha da Turma</h3>
            <p id="roomModalTurmaName">Turma: ...</p>
            <input type="password" id="roomPasswordInput" class="pin-input" autocomplete="current-password" placeholder="Senha da turma">
            <div class="modal-actions">
                <button class="btn-cancel" id="btnRoomCancel">Cancelar</button>
                <button id="btnRoomConfirm">Entrar na turma</button>
            </div>
        </div>
    </div>

    <!-- Modal de PIN da Avaliação -->
    <div class="modal-backdrop" id="evaluationModal">
        <div class="modal-card">
            <h3>Entrar na Avaliação</h3>
            <p id="evaluationModalTurmaName">Selecione a turma liberada pelo admin e informe o PIN.</p>
            <div class="evaluation-turma-list" id="evaluationTurmaList"></div>
            <input type="text" id="evaluationPinInput" class="pin-input" maxlength="4" pattern="\d{4}" inputmode="numeric" placeholder="0000">
            <div class="modal-actions">
                <button class="btn-cancel" id="btnEvaluationCancel">Cancelar</button>
                <button id="btnEvaluationConfirm">Confirmar PIN</button>
            </div>
        </div>
    </div>

    <script id="turmas-config" type="application/json">
        {
            "evaluatorName": <%- JSON.stringify(evaluatorName) %>,
            "activeEvaluationTurmas": <%- JSON.stringify(availableEvaluationTurmas) %>,
            "csrfToken": <%- JSON.stringify(csrfToken) %>
        }
    </script>
    <script>
        (function(){
            const cfg = JSON.parse(document.getElementById('turmas-config').textContent || '{}');
            const evaluatorName = cfg.evaluatorName;
            const activeSet = new Set((cfg.activeEvaluationTurmas || []).map(t => Number(t.id)));

            const globalBtn = document.getElementById('globalEvaluationButton');
            function updateGlobalButton() {
                const count = activeSet.size;
                globalBtn.classList.toggle('is-idle', count === 0);
                globalBtn.disabled = count === 0;
                globalBtn.querySelector('span').textContent = count === 0 ? 'Aguardando avaliação' : 'Entrar na avaliação';
                const strong = globalBtn.querySelector('strong');
                if (count > 0) {
                    if (!strong) {
                        const s = document.createElement('strong');
                        s.textContent = String(count);
                        globalBtn.appendChild(s);
                    } else {
                        strong.textContent = String(count);
                    }
                } else {
                    if (strong) strong.remove();
                }
            }

            function markTurmaActive(turmaId) {
                const card = document.querySelector(`.turma-card[data-turma-id="${turmaId}"]`);
                if (!card) return;
                const badge = card.querySelector('.turma-badge');
                if (badge) {
                    badge.classList.add('is-active');
                    badge.textContent = 'Avaliação liberada';
                }
            }
            function markTurmaIdle(turmaId) {
                const card = document.querySelector(`.turma-card[data-turma-id="${turmaId}"]`);
                if (!card) return;
                const badge = card.querySelector('.turma-badge');
                if (badge) {
                    badge.classList.remove('is-active');
                    badge.textContent = 'Disponível';
                }
            }

            updateGlobalButton();

            if (window.EventSource) {
                try {
                    const es = new EventSource('/events');
                    es.onmessage = (e) => {
                        try {
                            const payload = JSON.parse(e.data);
                            if (!payload) return;
                            if (payload.event === 'session_started' && payload.turmaId) {
                                activeSet.add(Number(payload.turmaId));
                                markTurmaActive(Number(payload.turmaId));
                                updateGlobalButton();
                                // dispatch custom event so other scripts can react
                                window.dispatchEvent(new CustomEvent('sse:session_started', { detail: payload }));
                            }
                            if (payload.event === 'session_closed' && payload.turmaId) {
                                activeSet.delete(Number(payload.turmaId));
                                markTurmaIdle(Number(payload.turmaId));
                                updateGlobalButton();
                                window.dispatchEvent(new CustomEvent('sse:session_closed', { detail: payload }));
                            }
                            if (payload.event === 'session_ended') {
                                // limpa todas as sessões ativas
                                Array.from(activeSet).forEach(tid => {
                                    markTurmaIdle(Number(tid));
                                });
                                activeSet.clear();
                                updateGlobalButton();
                                window.dispatchEvent(new CustomEvent('sse:session_ended'));
                            }
                        } catch (err) { console.error('SSE parse', err); }
                    };
                    es.onerror = (err) => {
                        // console.warn('EventSource error', err);
                    };
                } catch (e) { console.error('EventSource init failed', e); }
            }
        })();
    </script>
    <script>
        // Passa dados do servidor para o JS de forma segura para o linter
        window.TURMAS_CONFIG = JSON.parse(document.getElementById('turmas-config').textContent);
    </script>
    <script src="/transitions.js?v=2"></script>
    <script src="/toast.js?v=2"></script>
    <script src="/turmas.js"></script>

    <!-- Proteção: impede abertura de nova aba por padrão, mas respeita `target="_blank"` -->
    <script>
    (function() {
        document.querySelectorAll('a[href^="/"], form[action^="/"]').forEach(function(el) {
            // Preserve explicit new-tab intents and developer overrides
            const t = el.getAttribute('target');
            if ((t && t.toLowerCase() === '_blank') || el.hasAttribute('data-preserve-target')) {
                return;
            }
            el.removeAttribute('target');
        });
    })();
    </script>
    <script src="/theme.js"></script>
    <script src="/back.js"></script>
</body>
</html>
